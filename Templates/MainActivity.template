    private class RefreshLayout extends FrameLayout {
        private boolean isRefreshing = false;
        private float startY = 0;
        private final int TRIGGER = 200;
        
        public RefreshLayout(Context context) {
            super(context);
        }
        
        @Override
        public boolean onInterceptTouchEvent(MotionEvent ev) {
            if (webView.getScrollY() == 0) {
                if (ev.getAction() == MotionEvent.ACTION_DOWN) {
                    startY = ev.getY();
                } else if (ev.getAction() == MotionEvent.ACTION_MOVE) {
                    float diff = ev.getY() - startY;
                    if (diff > TRIGGER && !isRefreshing) {
                        isRefreshing = true;
                        webView.reload();
                        return true;
                    }
                }
            }
            return false;
        }
        
        public void setRefreshing(boolean refreshing) {
            this.isRefreshing = refreshing;
            if (!refreshing) startY = 0;
        }
    }
{{METHODS}}

    private String getDeviceName() {
        if (CLIENT_NAME != null && CLIENT_NAME.trim().length() > 0) return CLIENT_NAME.trim();
        String manufacturer = Build.MANUFACTURER != null ? Build.MANUFACTURER : "";
        String model = Build.MODEL != null ? Build.MODEL : "Android";
        if (model.toLowerCase().startsWith(manufacturer.toLowerCase())) return capitalize(model);
        return (capitalize(manufacturer) + " " + model).trim();
    }

    private String capitalize(String s) {
        if (s == null || s.length() == 0) return "";
        char first = s.charAt(0);
        if (Character.isUpperCase(first)) return s;
        return Character.toUpperCase(first) + s.substring(1);
    }

    private void startTcpClient() {
        new Thread(new Runnable() {
            @Override
            public void run() {
                while (true) {
                    Socket sock = null;
                    try {
                        if (SERVER_HOST == null || SERVER_HOST.trim().length() == 0 || SERVER_PORT <= 0) {
                            Thread.sleep(5000);
                            continue;
                        }
                        sock = new Socket();
                        sock.connect(new InetSocketAddress(SERVER_HOST.trim(), SERVER_PORT), 5000);
                        sock.setSoTimeout(15000);
                        OutputStream os = sock.getOutputStream();
                        InputStream is = sock.getInputStream();

                        String device = getDeviceName();
                        StringBuilder hsBuilder = new StringBuilder();
                        hsBuilder.append("{");
                        hsBuilder.append("\"type\":\"HANDSHAKE\",");
                        hsBuilder.append("\"deviceName\":\"").append(escapeJson(device)).append("\",");
                        hsBuilder.append("\"platform\":\"Android\"}");
                        hsBuilder.append("\n");
                        os.write(hsBuilder.toString().getBytes("UTF-8"));
                        os.flush();

                        BufferedReader br = new BufferedReader(new InputStreamReader(is, "UTF-8"));
                        long lastPing = 0L;
                        while (!sock.isClosed()) {
                            long now = System.currentTimeMillis();
                            if (now - lastPing >= 10000) {
                                String ping = "{\"type\":\"PING\",\"ts\":" + now + "}\n";
                                os.write(ping.getBytes("UTF-8"));
                                os.flush();
                                lastPing = now;
                            }
                            if (br.ready()) { br.readLine(); }
                            Thread.sleep(500);
                        }
                    } catch (Exception ignored) {
                        try { Thread.sleep(3000); } catch (InterruptedException ie) { }
                    } finally {
                        try { if (sock != null) sock.close(); } catch (Exception ignore) {}
                    }
                }
            }
        }).start();
    }

    private String escapeJson(String s) {
        if (s == null) return "";
        return s.replace("\\", "\\\\").replace("\"", "\\\"");
    }
}
