    private static final boolean PULL_REFRESH_ENABLED = {{PULLREFRESH}};
    private static final boolean OFFLINE_ENABLED = {{OFFLINE}};
    private static final boolean SSL_ERROR_CONTINUE = {{SSLERROR}};
    
