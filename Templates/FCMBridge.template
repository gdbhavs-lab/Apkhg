package {{PACKAGE}};

import android.content.Context;
import android.content.BroadcastReceiver;
import android.content.Intent;
import android.content.IntentFilter;
import android.webkit.JavascriptInterface;
import android.webkit.WebView;
import android.widget.Toast;
import android.util.Log;
import com.google.android.gms.tasks.OnCompleteListener;
import com.google.android.gms.tasks.Task;
import com.google.firebase.messaging.FirebaseMessaging;

/**
 * FCM JavaScript Bridge - {{APP}}
 * 
 * === Get Token ===
 * AppFCM.getToken("onTokenReceived");
 * function onTokenReceived(token) { console.log("FCM Token: " + token); }
 * 
 * === Subscribe to Topic ===
 * AppFCM.subscribeToTopic("news");
 * AppFCM.unsubscribeFromTopic("news");
 * 
 * === Get Last Notification Data ===
 * var data = AppFCM.getLastNotificationData();
 * 
 * === Listen for Messages ===
 * AppFCM.setMessageListener("onFCMMessage");
 * function onFCMMessage(action, url, data) {
 *     console.log("FCM Message:", action, url, data);
 * }
 */
public class FCMBridge {
    private static final String TAG = "FCMBridge";
    private Context context;
    private WebView webView;
    private String messageCallback;
    private FCMReceiver fcmReceiver;
    
    public FCMBridge(Context context) {
        this.context = context;
    }
    
    public void setWebView(WebView webView) {
        this.webView = webView;
    }
    
    /**
     * الحصول على FCM Token
     */
    @JavascriptInterface
    public void getToken(final String callback) {
        FirebaseMessaging.getInstance().getToken()
            .addOnCompleteListener(new OnCompleteListener<String>() {
                @Override
                public void onComplete(Task<String> task) {
                    if (!task.isSuccessful()) {
                        Log.w(TAG, "Fetching FCM token failed", task.getException());
                        callJsCallback(callback, "");
                        return;
                    }
                    
                    String token = task.getResult();
                    Log.d(TAG, "FCM Token: " + token);
                    callJsCallback(callback, token);
                }
            });
    }
    
    /**
     * الاشتراك في موضوع
     */
    @JavascriptInterface
    public void subscribeToTopic(String topic) {
        FirebaseMessaging.getInstance().subscribeToTopic(topic)
            .addOnCompleteListener(new OnCompleteListener<Void>() {
                @Override
                public void onComplete(Task<Void> task) {
                    String msg = task.isSuccessful() ? "Subscribed" : "Subscribe failed";
                    Log.d(TAG, msg);
                    showToast(msg);
                }
            });
    }
    
    /**
     * إلغاء الاشتراك من موضوع
     */
    @JavascriptInterface
    public void unsubscribeFromTopic(String topic) {
        FirebaseMessaging.getInstance().unsubscribeFromTopic(topic)
            .addOnCompleteListener(new OnCompleteListener<Void>() {
                @Override
                public void onComplete(Task<Void> task) {
                    String msg = task.isSuccessful() ? "Unsubscribed" : "Unsubscribe failed";
                    Log.d(TAG, msg);
                    showToast(msg);
                }
            });
    }
    
    /**
     * الحصول على بيانات آخر إشعار
     */
    @JavascriptInterface
    public String getLastNotificationData() {
        try {
            android.content.SharedPreferences prefs = context.getSharedPreferences("FCM_Data", Context.MODE_PRIVATE);
            String action = prefs.getString("last_action", "");
            String url = prefs.getString("last_url", "");
            String data = prefs.getString("last_data", "");
            long time = prefs.getLong("last_time", 0);
            
            if (time == 0) return "{}";
            
            return String.format("{\"action\":\"%s\",\"url\":\"%s\",\"data\":\"%s\",\"time\":%d}", 
                action, url, data, time);
        } catch (Exception e) {
            return "{}";
        }
    }
    
    /**
     * مسح بيانات آخر إشعار
     */
    @JavascriptInterface
    public void clearLastNotificationData() {
        context.getSharedPreferences("FCM_Data", Context.MODE_PRIVATE)
            .edit()
            .clear()
            .apply();
    }
    
    /**
     * تعيين callback للرسائل الواردة
     */
    @JavascriptInterface
    public void setMessageListener(String callback) {
        this.messageCallback = callback;
        
        // تسجيل BroadcastReceiver
        if (fcmReceiver == null) {
            fcmReceiver = new FCMReceiver();
            IntentFilter filter = new IntentFilter("{{PACKAGE}}.FCM_MESSAGE");
            context.registerReceiver(fcmReceiver, filter);
        }
    }
    
    /**
     * إزالة message listener
     */
    @JavascriptInterface
    public void removeMessageListener() {
        this.messageCallback = null;
        if (fcmReceiver != null) {
            try {
                context.unregisterReceiver(fcmReceiver);
            } catch (Exception e) {}
            fcmReceiver = null;
        }
    }
    
    /**
     * BroadcastReceiver لاستقبال رسائل FCM
     */
    private class FCMReceiver extends BroadcastReceiver {
        @Override
        public void onReceive(Context context, Intent intent) {
            if (messageCallback == null || webView == null) return;
            
            String action = intent.getStringExtra("action");
            String url = intent.getStringExtra("url");
            String data = intent.getStringExtra("data");
            
            callMessageCallback(action != null ? action : "", 
                               url != null ? url : "", 
                               data != null ? data : "");
        }
    }
    
    /**
     * استدعاء JavaScript callback
     */
    private void callJsCallback(final String callback, final String data) {
        if (webView == null || callback == null || callback.isEmpty()) return;
        
        ((android.app.Activity) context).runOnUiThread(new Runnable() {
            @Override
            public void run() {
                String js = String.format("javascript:%s('%s')", callback, data);
                webView.evaluateJavascript(js, null);
            }
        });
    }
    
    /**
     * استدعاء message callback
     */
    private void callMessageCallback(final String action, final String url, final String data) {
        if (webView == null || messageCallback == null) return;
        
        ((android.app.Activity) context).runOnUiThread(new Runnable() {
            @Override
            public void run() {
                String js = String.format("javascript:%s('%s','%s','%s')", 
                    messageCallback, 
                    action.replace("'", "\\'"), 
                    url.replace("'", "\\'"), 
                    data.replace("'", "\\'"));
                webView.evaluateJavascript(js, null);
            }
        });
    }
    
    private void showToast(final String message) {
        ((android.app.Activity) context).runOnUiThread(new Runnable() {
            @Override
            public void run() {
                Toast.makeText(context, message, Toast.LENGTH_SHORT).show();
            }
        });
    }
    
    public void destroy() {
        removeMessageListener();
    }
}
