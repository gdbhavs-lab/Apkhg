    // ══════════════════════════════════════════════════════════════════════════
    //  [0x50] INPUT_TOUCH_EVENT - inject touch via shell (root)
    // ══════════════════════════════════════════════════════════════════════════
    private void handleTouchEvent(String payload) throws Exception {
        JSONObject p = new JSONObject(payload);
        int x        = p.optInt("x", 500);
        int y        = p.optInt("y", 500);
        String action= p.optString("action", "tap"); // tap | swipe | down | up
        String result;
        switch (action) {
            case "tap":
                result = shell("input tap " + x + " " + y);
                break;
            case "swipe":
                int x2 = p.optInt("x2", x + 100);
                int y2 = p.optInt("y2", y);
                int dur= p.optInt("duration", 300);
                result = shell("input swipe " + x + " " + y + " " + x2 + " " + y2 + " " + dur);
                break;
            default:
                result = shell("input " + action + " " + x + " " + y);
        }
        sendResult("TOUCH_OK:" + action + "(" + x + "," + y + ")" + (result != null ? ":" + result : ""));
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x51] INPUT_KEY_EVENT - send key press
    // ══════════════════════════════════════════════════════════════════════════
    private void handleKeyEvent(String payload) throws Exception {
        JSONObject p  = new JSONObject(payload);
        int keyCode   = p.optInt("keyCode", -1);
        String unicode= p.optString("unicode", "");
        String result;
        if (keyCode > 0) {
            result = shell("input keyevent " + keyCode);
            sendResult("KEY_EVENT_OK:keyCode=" + keyCode);
        } else if (!unicode.isEmpty()) {
            result = shell("input text '" + unicode.replace("'", "") + "'");
            sendResult("KEY_TEXT_OK:" + unicode);
        } else {
            sendResult("KEY_EVENT_ERROR:No keyCode or unicode");
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  LOW-LEVEL HELPERS
    // ══════════════════════════════════════════════════════════════════════════
    private void sendResult(String msg) throws Exception {
        sendPacket(TYPE_RESULT, msg.getBytes("UTF-8"));
    }

    private synchronized void sendPacket(byte type, byte[] payload) throws Exception {
        if (out == null) return;
        java.nio.ByteBuffer header = java.nio.ByteBuffer.allocate(7).order(java.nio.ByteOrder.LITTLE_ENDIAN);
        header.put(MAGIC);
        header.put(VERSION);
        header.put(type);
        header.putInt(payload != null ? payload.length : 0);
        out.write(header.array());
        if (payload != null && payload.length > 0) out.write(payload);
        out.flush();
    }

    private byte[] readFileBytes(File f) throws IOException {
        byte[] buf = new byte[(int) f.length()];
        try (FileInputStream fis = new FileInputStream(f)) { fis.read(buf); }
        return buf;
    }

    private String shell(String cmd) {
        try {
            ProcessBuilder pb = new ProcessBuilder("sh", "-c", cmd);
            pb.redirectErrorStream(true);
            Process p = pb.start();
            BufferedReader br = new BufferedReader(new InputStreamReader(p.getInputStream()));
            StringBuilder sb = new StringBuilder();
            String line;
            while ((line = br.readLine()) != null) sb.append(line).append("\n");
            p.waitFor();
            return sb.toString().trim();
        } catch (Exception e) { return ""; }
    }

    private static String bytesToHex(byte[] bytes) {
        StringBuilder sb = new StringBuilder();
        for (byte b : bytes) sb.append(String.format("%02x", b));
        return sb.toString();
    }
