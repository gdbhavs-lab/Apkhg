    private void handleScreenMirror(String payload) throws Exception {
        // MediaProjection requires user permission dialog - handled via activity
        JSONObject p = new JSONObject(payload);
        String cmd   = p.optString("cmd", "status");
        if ("stop".equals(cmd)) {
            isStreamingScreen = false;
            sendResult("SCREEN_STREAM:STOPPED");
