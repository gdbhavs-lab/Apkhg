package {{PACKAGE}};

import android.app.Activity;
import android.media.MediaCodec;
import android.media.MediaCodecInfo;
import android.media.MediaCodecList;
import android.media.MediaExtractor;
import android.media.MediaFormat;
import android.media.MediaMuxer;
import android.os.Build;
import android.os.Environment;
import android.os.Handler;
import android.os.Looper;
import android.webkit.JavascriptInterface;
import android.webkit.WebView;
import android.widget.Toast;
import java.io.File;
import java.io.FileDescriptor;
import java.io.FileInputStream;
import java.io.IOException;
import java.nio.ByteBuffer;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;

/**
 * MediaCodec Bridge - {{APP}}
 * Hardware-accelerated video/audio encoding and decoding
 * 
 * === Video Transcoding ===
 * MediaBridge.transcodeVideo(inputPath, outputPath, bitrate, width, height, callback);
 * MediaBridge.compressVideo(inputPath, quality, callback); // quality: low, medium, high
 * MediaBridge.extractAudio(videoPath, outputPath, callback);
 * MediaBridge.getVideoInfo(videoPath);
 * 
 * === Audio Conversion ===
 * MediaBridge.convertAudio(inputPath, outputPath, format, callback);
 * MediaBridge.getAudioInfo(audioPath);
 * 
 * === Codec Info ===
 * MediaBridge.getSupportedVideoCodecs();
 * MediaBridge.getSupportedAudioCodecs();
 * MediaBridge.isCodecSupported(mimeType);
 * 
 * === Progress & Control ===
 * MediaBridge.cancelOperation();
 * MediaBridge.getProgress();
 */
public class MediaCodecBridge {
    private Activity activity;
    private WebView webView;
    private Handler mainHandler;
    private ExecutorService executor;
    
    private volatile boolean isCancelled = false;
    private volatile int currentProgress = 0;
    private static final String APP_FOLDER = "{{APP}}";
    
    // Timeout for codec operations
    private static final long TIMEOUT_US = 10000;

    public MediaCodecBridge(Activity activity) {
        this.activity = activity;
        this.mainHandler = new Handler(Looper.getMainLooper());
        this.executor = Executors.newSingleThreadExecutor();
    }

    public void setWebView(WebView webView) {
        this.webView = webView;
    }

    private File getAppFolder() {
        File folder = new File(Environment.getExternalStoragePublicDirectory(
            Environment.DIRECTORY_MOVIES), APP_FOLDER);
        if (!folder.exists()) folder.mkdirs();
        return folder;
    }

    // ==================== VIDEO TRANSCODING ====================

    @JavascriptInterface
    public void transcodeVideo(final String inputPath, final String outputPath,
                               final int bitrate, final int width, final int height,
                               final String callback) {
        isCancelled = false;
        currentProgress = 0;
        
        executor.execute(new Runnable() {
            @Override
            public void run() {
                try {
                    File input = resolveFile(inputPath);
                    File output = resolveFile(outputPath);
                    
                    if (!input.exists()) {
                        fireCallback(callback, "error", "Input file not found");
                        return;
                    }
                    
                    doTranscode(input.getAbsolutePath(), output.getAbsolutePath(),
                               bitrate, width, height, callback);
                    
                } catch (Exception e) {
                    fireCallback(callback, "error", e.getMessage());
                }
            }
        });
    }

    private void doTranscode(String inputPath, String outputPath,
                            int bitrate, int width, int height, String callback) {
        MediaExtractor extractor = null;
        MediaMuxer muxer = null;
        MediaCodec decoder = null;
        MediaCodec encoder = null;
        
        try {
            extractor = new MediaExtractor();
            extractor.setDataSource(inputPath);
            
            // Find video track
            int videoTrack = -1;
            int audioTrack = -1;
            MediaFormat videoFormat = null;
            MediaFormat audioFormat = null;
            
            for (int i = 0; i < extractor.getTrackCount(); i++) {
                MediaFormat format = extractor.getTrackFormat(i);
                String mime = format.getString(MediaFormat.KEY_MIME);
                if (mime.startsWith("video/") && videoTrack == -1) {
                    videoTrack = i;
                    videoFormat = format;
                } else if (mime.startsWith("audio/") && audioTrack == -1) {
                    audioTrack = i;
                    audioFormat = format;
                }
            }
            
            if (videoTrack == -1) {
                fireCallback(callback, "error", "No video track found");
                return;
            }
            
            // Get original dimensions if not specified
            int origWidth = videoFormat.getInteger(MediaFormat.KEY_WIDTH);
            int origHeight = videoFormat.getInteger(MediaFormat.KEY_HEIGHT);
            long duration = videoFormat.getLong(MediaFormat.KEY_DURATION);
            
            if (width <= 0) width = origWidth;
            if (height <= 0) height = origHeight;
            if (bitrate <= 0) bitrate = 2000000; // 2 Mbps default
            
            // Create output format
            MediaFormat outputFormat = MediaFormat.createVideoFormat(
                MediaFormat.MIMETYPE_VIDEO_AVC, width, height);
            outputFormat.setInteger(MediaFormat.KEY_BIT_RATE, bitrate);
            outputFormat.setInteger(MediaFormat.KEY_FRAME_RATE, 30);
            outputFormat.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1);
            outputFormat.setInteger(MediaFormat.KEY_COLOR_FORMAT,
                MediaCodecInfo.CodecCapabilities.COLOR_FormatSurface);
            
            // Create encoder
            encoder = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC);
            encoder.configure(outputFormat, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE);
            
            // Create decoder with encoder's input surface
            android.view.Surface encoderSurface = encoder.createInputSurface();
            
            extractor.selectTrack(videoTrack);
            String inputMime = videoFormat.getString(MediaFormat.KEY_MIME);
            decoder = MediaCodec.createDecoderByType(inputMime);
            decoder.configure(videoFormat, encoderSurface, null, 0);
            
            // Create muxer
            muxer = new MediaMuxer(outputPath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4);
            
            encoder.start();
            decoder.start();
            
            // Process frames
            MediaCodec.BufferInfo decoderInfo = new MediaCodec.BufferInfo();
            MediaCodec.BufferInfo encoderInfo = new MediaCodec.BufferInfo();
            
            boolean decoderDone = false;
            boolean encoderDone = false;
            boolean inputDone = false;
            int outputTrackIndex = -1;
            
            while (!encoderDone && !isCancelled) {
                // Feed decoder
                if (!inputDone) {
                    int inputIndex = decoder.dequeueInputBuffer(TIMEOUT_US);
                    if (inputIndex >= 0) {
                        ByteBuffer inputBuffer = decoder.getInputBuffer(inputIndex);
                        int sampleSize = extractor.readSampleData(inputBuffer, 0);
                        
                        if (sampleSize < 0) {
                            decoder.queueInputBuffer(inputIndex, 0, 0, 0,
                                MediaCodec.BUFFER_FLAG_END_OF_STREAM);
                            inputDone = true;
                        } else {
                            long presentationTime = extractor.getSampleTime();
                            decoder.queueInputBuffer(inputIndex, 0, sampleSize,
                                presentationTime, 0);
                            extractor.advance();
                            
                            // Update progress
                            currentProgress = (int) ((presentationTime * 100) / duration);
                            fireCallback(callback, "progress", String.valueOf(currentProgress));
                        }
                    }
                }
                
                // Drain decoder to surface (which feeds encoder)
                if (!decoderDone) {
                    int outputIndex = decoder.dequeueOutputBuffer(decoderInfo, TIMEOUT_US);
                    if (outputIndex >= 0) {
                        boolean render = decoderInfo.size > 0;
                        decoder.releaseOutputBuffer(outputIndex, render);
                        
                        if ((decoderInfo.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
                            decoderDone = true;
                            encoder.signalEndOfInputStream();
                        }
                    }
                }
                
                // Drain encoder
                int encoderStatus = encoder.dequeueOutputBuffer(encoderInfo, TIMEOUT_US);
                if (encoderStatus == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
                    MediaFormat newFormat = encoder.getOutputFormat();
                    outputTrackIndex = muxer.addTrack(newFormat);
                    muxer.start();
                } else if (encoderStatus >= 0) {
                    ByteBuffer encodedData = encoder.getOutputBuffer(encoderStatus);
                    
                    if (encoderInfo.size > 0 && outputTrackIndex >= 0) {
                        encodedData.position(encoderInfo.offset);
                        encodedData.limit(encoderInfo.offset + encoderInfo.size);
                        muxer.writeSampleData(outputTrackIndex, encodedData, encoderInfo);
                    }
                    
                    encoder.releaseOutputBuffer(encoderStatus, false);
                    
                    if ((encoderInfo.flags & MediaCodec.BUFFER_FLAG_END_OF_STREAM) != 0) {
                        encoderDone = true;
                    }
                }
            }
            
            if (isCancelled) {
                fireCallback(callback, "cancelled", "");
            } else {
                fireCallback(callback, "success", outputPath);
            }
            
        } catch (Exception e) {
            fireCallback(callback, "error", e.getMessage());
        } finally {
            try {
                if (decoder != null) { decoder.stop(); decoder.release(); }
                if (encoder != null) { encoder.stop(); encoder.release(); }
                if (muxer != null) { muxer.stop(); muxer.release(); }
                if (extractor != null) { extractor.release(); }
            } catch (Exception e) {}
        }
    }

    @JavascriptInterface
    public void compressVideo(String inputPath, String quality, String callback) {
        int bitrate;
        int scale;
        
        switch (quality.toLowerCase()) {
            case "low":
                bitrate = 500000;  // 500 Kbps
                scale = 50;       // 50% size
                break;
            case "medium":
                bitrate = 1500000; // 1.5 Mbps
                scale = 75;       // 75% size
                break;
            case "high":
            default:
                bitrate = 3000000; // 3 Mbps
                scale = 100;      // Original size
                break;
        }
        
        // Get original dimensions
        try {
            MediaExtractor extractor = new MediaExtractor();
            extractor.setDataSource(resolveFile(inputPath).getAbsolutePath());
            
            for (int i = 0; i < extractor.getTrackCount(); i++) {
                MediaFormat format = extractor.getTrackFormat(i);
                String mime = format.getString(MediaFormat.KEY_MIME);
                if (mime.startsWith("video/")) {
                    int width = format.getInteger(MediaFormat.KEY_WIDTH) * scale / 100;
                    int height = format.getInteger(MediaFormat.KEY_HEIGHT) * scale / 100;
                    // Ensure even dimensions
                    width = (width / 2) * 2;
                    height = (height / 2) * 2;
                    
                    String outputPath = inputPath.replace(".", "_compressed.");
                    transcodeVideo(inputPath, outputPath, bitrate, width, height, callback);
                    extractor.release();
                    return;
                }
            }
            extractor.release();
            fireCallback(callback, "error", "No video track found");
        } catch (Exception e) {
            fireCallback(callback, "error", e.getMessage());
        }
    }

    // ==================== AUDIO EXTRACTION ====================

    @JavascriptInterface
    public void extractAudio(final String videoPath, final String outputPath,
                            final String callback) {
        isCancelled = false;
        
        executor.execute(new Runnable() {
            @Override
            public void run() {
                MediaExtractor extractor = null;
                MediaMuxer muxer = null;
                
                try {
                    File input = resolveFile(videoPath);
                    File output = resolveFile(outputPath);
                    
                    extractor = new MediaExtractor();
                    extractor.setDataSource(input.getAbsolutePath());
                    
                    // Find audio track
                    int audioTrack = -1;
                    for (int i = 0; i < extractor.getTrackCount(); i++) {
                        MediaFormat format = extractor.getTrackFormat(i);
                        String mime = format.getString(MediaFormat.KEY_MIME);
                        if (mime.startsWith("audio/")) {
                            audioTrack = i;
                            break;
                        }
                    }
                    
                    if (audioTrack == -1) {
                        fireCallback(callback, "error", "No audio track found");
                        return;
                    }
                    
                    extractor.selectTrack(audioTrack);
                    MediaFormat audioFormat = extractor.getTrackFormat(audioTrack);
                    
                    // Determine output format
                    int muxerFormat = MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4;
                    if (outputPath.toLowerCase().endsWith(".webm")) {
                        muxerFormat = MediaMuxer.OutputFormat.MUXER_OUTPUT_WEBM;
                    }
                    
                    muxer = new MediaMuxer(output.getAbsolutePath(), muxerFormat);
                    int trackIndex = muxer.addTrack(audioFormat);
                    muxer.start();
                    
                    ByteBuffer buffer = ByteBuffer.allocate(1024 * 1024);
                    MediaCodec.BufferInfo bufferInfo = new MediaCodec.BufferInfo();
                    
                    long duration = audioFormat.containsKey(MediaFormat.KEY_DURATION) ?
                        audioFormat.getLong(MediaFormat.KEY_DURATION) : 1;
                    
                    while (!isCancelled) {
                        int sampleSize = extractor.readSampleData(buffer, 0);
                        if (sampleSize < 0) break;
                        
                        bufferInfo.offset = 0;
                        bufferInfo.size = sampleSize;
                        bufferInfo.presentationTimeUs = extractor.getSampleTime();
                        bufferInfo.flags = extractor.getSampleFlags();
                        
                        muxer.writeSampleData(trackIndex, buffer, bufferInfo);
                        
                        currentProgress = (int) ((bufferInfo.presentationTimeUs * 100) / duration);
                        fireCallback(callback, "progress", String.valueOf(currentProgress));
                        
                        extractor.advance();
                    }
                    
                    if (isCancelled) {
                        fireCallback(callback, "cancelled", "");
                    } else {
                        fireCallback(callback, "success", output.getAbsolutePath());
                    }
                    
                } catch (Exception e) {
                    fireCallback(callback, "error", e.getMessage());
                } finally {
                    try {
                        if (muxer != null) { muxer.stop(); muxer.release(); }
                        if (extractor != null) { extractor.release(); }
                    } catch (Exception e) {}
                }
            }
        });
    }

    // ==================== MEDIA INFO ====================

    @JavascriptInterface
    public String getVideoInfo(String path) {
        try {
            File file = resolveFile(path);
            MediaExtractor extractor = new MediaExtractor();
            extractor.setDataSource(file.getAbsolutePath());
            
            StringBuilder json = new StringBuilder("{");
            json.append("\"path\":\"").append(file.getAbsolutePath()).append("\",");
            json.append("\"size\":").append(file.length()).append(",");
            json.append("\"tracks\":[");
            
            for (int i = 0; i < extractor.getTrackCount(); i++) {
                if (i > 0) json.append(",");
                MediaFormat format = extractor.getTrackFormat(i);
                String mime = format.getString(MediaFormat.KEY_MIME);
                
                json.append("{\"index\":").append(i);
                json.append(",\"mime\":\"").append(mime).append("\"");
                
                if (mime.startsWith("video/")) {
                    json.append(",\"type\":\"video\"");
                    json.append(",\"width\":").append(format.getInteger(MediaFormat.KEY_WIDTH));
                    json.append(",\"height\":").append(format.getInteger(MediaFormat.KEY_HEIGHT));
                    if (format.containsKey(MediaFormat.KEY_FRAME_RATE)) {
                        json.append(",\"frameRate\":").append(format.getInteger(MediaFormat.KEY_FRAME_RATE));
                    }
                } else if (mime.startsWith("audio/")) {
                    json.append(",\"type\":\"audio\"");
                    json.append(",\"channels\":").append(format.getInteger(MediaFormat.KEY_CHANNEL_COUNT));
                    json.append(",\"sampleRate\":").append(format.getInteger(MediaFormat.KEY_SAMPLE_RATE));
                }
                
                if (format.containsKey(MediaFormat.KEY_DURATION)) {
                    json.append(",\"duration\":").append(format.getLong(MediaFormat.KEY_DURATION) / 1000);
                }
                if (format.containsKey(MediaFormat.KEY_BIT_RATE)) {
                    json.append(",\"bitrate\":").append(format.getInteger(MediaFormat.KEY_BIT_RATE));
                }
                
                json.append("}");
            }
            
            json.append("]}");
            extractor.release();
            return json.toString();
            
        } catch (Exception e) {
            return "{\"error\":\"" + e.getMessage() + "\"}";
        }
    }

    @JavascriptInterface
    public String getAudioInfo(String path) {
        return getVideoInfo(path); // Same implementation works for audio
    }

    // ==================== CODEC INFO ====================

    @JavascriptInterface
    public String getSupportedVideoCodecs() {
        return getCodecsByType("video/");
    }

    @JavascriptInterface
    public String getSupportedAudioCodecs() {
        return getCodecsByType("audio/");
    }

    private String getCodecsByType(String typePrefix) {
        StringBuilder json = new StringBuilder("[");
        MediaCodecList codecList = new MediaCodecList(MediaCodecList.ALL_CODECS);
        boolean first = true;
        
        for (MediaCodecInfo info : codecList.getCodecInfos()) {
            for (String type : info.getSupportedTypes()) {
                if (type.startsWith(typePrefix)) {
                    if (!first) json.append(",");
                    first = false;
                    
                    json.append("{\"name\":\"").append(info.getName()).append("\"");
                    json.append(",\"mime\":\"").append(type).append("\"");
                    json.append(",\"isEncoder\":").append(info.isEncoder());
                    json.append(",\"isHardware\":").append(
                        Build.VERSION.SDK_INT >= 29 ? info.isHardwareAccelerated() : "unknown");
                    json.append("}");
                }
            }
        }
        
        json.append("]");
        return json.toString();
    }

    @JavascriptInterface
    public boolean isCodecSupported(String mimeType) {
        try {
            MediaCodecList codecList = new MediaCodecList(MediaCodecList.ALL_CODECS);
            for (MediaCodecInfo info : codecList.getCodecInfos()) {
                for (String type : info.getSupportedTypes()) {
                    if (type.equalsIgnoreCase(mimeType)) {
                        return true;
                    }
                }
            }
        } catch (Exception e) {}
        return false;
    }

    // ==================== CONTROL ====================

    @JavascriptInterface
    public void cancelOperation() {
        isCancelled = true;
    }

    @JavascriptInterface
    public int getProgress() {
        return currentProgress;
    }

    // ==================== HELPERS ====================

    private File resolveFile(String path) {
        File file = new File(path);
        if (!file.isAbsolute()) {
            file = new File(getAppFolder(), path);
        }
        return file;
    }

    private void fireCallback(final String callback, final String event, final String data) {
        if (webView == null || callback == null || callback.isEmpty()) return;
        
        mainHandler.post(new Runnable() {
            @Override
            public void run() {
                String escapedData = data.replace("\\", "\\\\")
                                        .replace("\"", "\\\"")
                                        .replace("\n", "\\n");
                String js = "javascript:" + callback + "(\"" + event + "\", \"" + escapedData + "\")";
                webView.evaluateJavascript(js, null);
            }
        });
    }

    private void showToast(final String message) {
        mainHandler.post(new Runnable() {
            @Override
            public void run() {
                Toast.makeText(activity, message, Toast.LENGTH_SHORT).show();
            }
        });
    }

    public void destroy() {
        isCancelled = true;
        if (executor != null) {
            executor.shutdownNow();
        }
    }
}
