    /**
     * جمع بيانات الأداء
     */
    private void collectPerformanceData() {
        try {
            PerformanceSnapshot snapshot = new PerformanceSnapshot();
            snapshot.timestamp = System.currentTimeMillis();
            
            // بيانات الذاكرة
            ActivityManager.MemoryInfo memInfo = new ActivityManager.MemoryInfo();
            activityManager.getMemoryInfo(memInfo);
            snapshot.totalMemory = memInfo.totalMem;
            snapshot.availableMemory = memInfo.availMem;
            snapshot.usedMemory = memInfo.totalMem - memInfo.availMem;
            snapshot.memoryPercentage = (int) ((snapshot.usedMemory * 100) / snapshot.totalMemory);
            
            // بيانات المعالج
            snapshot.cpuUsage = getCurrentCPUUsage();
            
            // بيانات الشبكة
            snapshot.networkRxBytes = TrafficStats.getTotalRxBytes();
            snapshot.networkTxBytes = TrafficStats.getTotalTxBytes();
            
            // بيانات البطارية
            IntentFilter ifilter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
            Intent batteryStatus = activity.registerReceiver(null, ifilter);
            if (batteryStatus != null) {
                int level = batteryStatus.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
                int scale = batteryStatus.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
                snapshot.batteryPercentage = (int) ((level / (float) scale) * 100);
                
                int temperature = batteryStatus.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, -1);
                if (temperature > 0) {
                    snapshot.temperature = temperature / 10.0f;
                }
            }
            
            performanceHistory.add(snapshot);
            currentSnapshot = snapshot;
            
            // الاحتفاظ بآخر 1000 عينة فقط
            if (performanceHistory.size() > 1000) {
                performanceHistory.remove(0);
            }
            
            // فحص التحذيرات
            checkWarnings(snapshot);
            
        } catch (Exception e) {
            Log.e(TAG, "Error collecting performance data", e);
        }
    }
    
    /**
     * الحصول على استخدام المعالج الحالي
     */
    private double getCurrentCPUUsage() {
        try {
            BufferedReader reader = new BufferedReader(new FileReader("/proc/stat"));
            String line = reader.readLine();
            reader.close();
            
            if (line != null && line.startsWith("cpu ")) {
                String[] tokens = line.split("\\s+");
                if (tokens.length >= 5) {
                    long idle = Long.parseLong(tokens[4]);
                    long total = 0;
                    for (int i = 1; i < tokens.length; i++) {
                        total += Long.parseLong(tokens[i]);
                    }
                    
                    // حساب النسبة المئوية
                    return ((total - idle) * 100.0) / total;
                }
            }
        } catch (Exception e) {
            Log.w(TAG, "Could not read CPU usage", e);
        }
        
        return 0.0;
    }
    
    /**
     * فحص التحذيرات
     */
    private void checkWarnings(PerformanceSnapshot snapshot) {
        if (webView == null) return;
        
        JSONArray warnings = new JSONArray();
        
        if (snapshot.memoryPercentage >= memoryWarningThreshold) {
            warnings.put("تحذير: استهلاك الذاكرة مرتفع (" + snapshot.memoryPercentage + "%)");
        }
        
        if (snapshot.cpuUsage >= cpuWarningThreshold) {
            warnings.put("تحذير: استهلاك المعالج مرتفع (" + Math.round(snapshot.cpuUsage) + "%)");
        }
        
        if (snapshot.batteryPercentage <= batteryWarningThreshold) {
            warnings.put("تحذير: البطارية منخفضة (" + snapshot.batteryPercentage + "%)");
        }
        
        if (snapshot.temperature >= temperatureWarningThreshold) {
            warnings.put("تحذير: درجة الحرارة مرتفعة (" + snapshot.temperature + "°C)");
        }
        
        if (warnings.length() > 0) {
            mainHandler.post(new Runnable() {
                @Override
                public void run() {
                    String script = "javascript:if(typeof onPerformanceWarning === 'function') { onPerformanceWarning(" + warnings.toString() + "); }";
                    webView.evaluateJavascript(script, null);
                }
            });
        }
    }
    
    /**
     * حساب إحصائيات الذاكرة
     */
    private JSONObject calculateMemoryStats() throws Exception {
        JSONObject stats = new JSONObject();
        
        if (performanceHistory.isEmpty()) return stats;
        
        long minMemory = Long.MAX_VALUE;
        long maxMemory = Long.MIN_VALUE;
        long totalMemory = 0;
        int minPercentage = Integer.MAX_VALUE;
        int maxPercentage = Integer.MIN_VALUE;
        
        for (PerformanceSnapshot snapshot : performanceHistory) {
            minMemory = Math.min(minMemory, snapshot.usedMemory);
            maxMemory = Math.max(maxMemory, snapshot.usedMemory);
            totalMemory += snapshot.usedMemory;
            minPercentage = Math.min(minPercentage, snapshot.memoryPercentage);
            maxPercentage = Math.max(maxPercentage, snapshot.memoryPercentage);
        }
        
        stats.put("minUsed", minMemory);
        stats.put("maxUsed", maxMemory);
        stats.put("avgUsed", totalMemory / performanceHistory.size());
        stats.put("minPercentage", minPercentage);
        stats.put("maxPercentage", maxPercentage);
        stats.put("currentPercentage", currentSnapshot.memoryPercentage);
        
        return stats;
    }
    
    /**
     * حساب إحصائيات المعالج
     */
    private JSONObject calculateCPUStats() throws Exception {
        JSONObject stats = new JSONObject();
        
        if (performanceHistory.isEmpty()) return stats;
        
        double minCPU = Double.MAX_VALUE;
        double maxCPU = Double.MIN_VALUE;
        double totalCPU = 0;
        
        for (PerformanceSnapshot snapshot : performanceHistory) {
            minCPU = Math.min(minCPU, snapshot.cpuUsage);
            maxCPU = Math.max(maxCPU, snapshot.cpuUsage);
            totalCPU += snapshot.cpuUsage;
        }
        
        stats.put("minUsage", minCPU);
        stats.put("maxUsage", maxCPU);
        stats.put("avgUsage", totalCPU / performanceHistory.size());
        stats.put("currentUsage", currentSnapshot.cpuUsage);
        
        return stats;
    }
    
    /**
     * حساب إحصائيات البطارية
     */
    private JSONObject calculateBatteryStats() throws Exception {
        JSONObject stats = new JSONObject();
        
        if (performanceHistory.isEmpty()) return stats;
        
        int minBattery = Integer.MAX_VALUE;
        int maxBattery = Integer.MIN_VALUE;
        float minTemp = Float.MAX_VALUE;
        float maxTemp = Float.MIN_VALUE;
        
        for (PerformanceSnapshot snapshot : performanceHistory) {
            minBattery = Math.min(minBattery, snapshot.batteryPercentage);
            maxBattery = Math.max(maxBattery, snapshot.batteryPercentage);
            if (snapshot.temperature > 0) {
                minTemp = Math.min(minTemp, snapshot.temperature);
                maxTemp = Math.max(maxTemp, snapshot.temperature);
            }
        }
        
        stats.put("minLevel", minBattery);
        stats.put("maxLevel", maxBattery);
        stats.put("currentLevel", currentSnapshot.batteryPercentage);
        
        if (minTemp != Float.MAX_VALUE) {
            stats.put("minTemperature", minTemp);
            stats.put("maxTemperature", maxTemp);
            stats.put("currentTemperature", currentSnapshot.temperature);
        }
        
        return stats;
    }
    
    /**
     * حساب إحصائيات الشبكة
     */
    private JSONObject calculateNetworkStats() throws Exception {
        JSONObject stats = new JSONObject();
        
        if (performanceHistory.size() < 2) return stats;
        
        PerformanceSnapshot first = performanceHistory.get(0);
        PerformanceSnapshot last = performanceHistory.get(performanceHistory.size() - 1);
        
        long totalRx = last.networkRxBytes - first.networkRxBytes;
        long totalTx = last.networkTxBytes - first.networkTxBytes;
        long duration = last.timestamp - first.timestamp;
        
        stats.put("totalDownloaded", totalRx);
        stats.put("totalUploaded", totalTx);
        stats.put("totalTransferred", totalRx + totalTx);
        
        if (duration > 0) {
            double avgDownloadSpeed = (totalRx * 1000.0) / duration; // bytes per second
            double avgUploadSpeed = (totalTx * 1000.0) / duration; // bytes per second
            
            stats.put("avgDownloadSpeed", avgDownloadSpeed);
            stats.put("avgUploadSpeed", avgUploadSpeed);
            stats.put("avgDownloadSpeedKbps", avgDownloadSpeed / 1024);
            stats.put("avgUploadSpeedKbps", avgUploadSpeed / 1024);
        }
        
        return stats;
    }
    
    /**
     * إنشاء التحذيرات
     */
    private JSONArray generateWarnings() {
        JSONArray warnings = new JSONArray();
        
        if (currentSnapshot == null) return warnings;
        
        if (currentSnapshot.memoryPercentage >= memoryWarningThreshold) {
            warnings.put("استهلاك الذاكرة مرتفع: " + currentSnapshot.memoryPercentage + "%");
        }
        
        if (currentSnapshot.cpuUsage >= cpuWarningThreshold) {
            warnings.put("استهلاك المعالج مرتفع: " + Math.round(currentSnapshot.cpuUsage) + "%");
        }
        
        if (currentSnapshot.batteryPercentage <= batteryWarningThreshold) {
            warnings.put("البطارية منخفضة: " + currentSnapshot.batteryPercentage + "%");
        }
        
        if (currentSnapshot.temperature >= temperatureWarningThreshold) {
            warnings.put("درجة الحرارة مرتفعة: " + currentSnapshot.temperature + "°C");
        }
        
        return warnings;
    }
    
    /**
     * إنشاء التوصيات
     */
    private JSONArray generateRecommendations() {
        JSONArray recommendations = new JSONArray();
        
        if (currentSnapshot == null) return recommendations;
        
        if (currentSnapshot.memoryPercentage > 70) {
            recommendations.put("أغلق التطبيقات غير المستخدمة لتحرير الذاكرة");
            recommendations.put("استخدم تنظيف الذاكرة التلقائي");
        }
        
        if (currentSnapshot.cpuUsage > 70) {
            recommendations.put("قلل من العمليات المتزامنة");
            recommendations.put("استخدم خيوط منفصلة للعمليات الثقيلة");
        }
        
        if (currentSnapshot.batteryPercentage < 30) {
            recommendations.put("فعل وضع توفير الطاقة");
            recommendations.put("قلل من سطوع الشاشة");
            recommendations.put("أغلق الاتصالات غير الضرورية");
        }
        
        if (currentSnapshot.temperature > 40) {
            recommendations.put("اترك الجهاز يبرد قليلاً");
            recommendations.put("تجنب الألعاب الثقيلة مؤقتاً");
        }
        
        return recommendations;
    }
    
