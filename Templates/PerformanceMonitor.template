/**
 * مراقب الأداء المتقدم للألعاب - Performance Monitor for Games
 * 
 * الميزات:
 * - مراقبة استهلاك الذاكرة (RAM/Heap) في الوقت الفعلي
 * - مراقبة استهلاك المعالج (CPU) مع تفاصيل النوى
 * - مراقبة استهلاك البطارية ودرجة الحرارة
 * - مراقبة حركة الشبكة (Upload/Download)
 * - مراقبة معدل الإطارات (FPS) للألعاب
 * - إنذارات الأداء التلقائية
 * - تقارير الأداء المفصلة
 * - تحسينات تلقائية للأداء
 * 
 * @author APK Professional Builder
 * @version 2.0 - Gaming Edition
 */
public class PerformanceMonitor {
    private static final String TAG = "PerformanceMonitor";
    private Activity activity;
    private WebView webView;
    private ActivityManager activityManager;
    private Timer monitoringTimer;
    private Handler mainHandler;
    
    // إعدادات المراقبة
    private boolean isMonitoring = false;
    private int monitoringInterval = 1000; // 1 ثانية
    private long startTime;
    private long initialRxBytes;
    private long initialTxBytes;
    
    // حدود الإنذارات
    private int memoryWarningThreshold = 80; // 80% من الذاكرة
    private int cpuWarningThreshold = 85; // 85% من المعالج
    private int batteryWarningThreshold = 15; // 15% بطارية
    private int temperatureWarningThreshold = 45; // 45 درجة مئوية
    
    // إحصائيات الأداء
    private List<PerformanceSnapshot> performanceHistory;
    private PerformanceSnapshot currentSnapshot;
    
    public PerformanceMonitor(Activity activity) {
        this.activity = activity;
        this.activityManager = (ActivityManager) activity.getSystemService(Context.ACTIVITY_SERVICE);
        this.mainHandler = new Handler(Looper.getMainLooper());
        this.performanceHistory = new ArrayList<>();
        this.startTime = System.currentTimeMillis();
        this.initialRxBytes = TrafficStats.getTotalRxBytes();
        this.initialTxBytes = TrafficStats.getTotalTxBytes();
    }
    
    public void setWebView(WebView webView) {
        this.webView = webView;
    }
    
    /**
     * بدء مراقبة الأداء
     */
    @JavascriptInterface
    public void startMonitoring(final String callback) {
        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    if (isMonitoring) {
                        executeCallback(callback, createErrorResponse("المراقبة نشطة بالفعل"));
                        return;
                    }
                    
                    isMonitoring = true;
                    startTime = System.currentTimeMillis();
                    
                    monitoringTimer = new Timer();
                    monitoringTimer.scheduleAtFixedRate(new TimerTask() {
                        @Override
                        public void run() {
                            collectPerformanceData();
                        }
                    }, 0, monitoringInterval);
                    
                    executeCallback(callback, createSuccessResponse("تم بدء مراقبة الأداء بنجاح"));
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error starting performance monitoring", e);
                    executeCallback(callback, createErrorResponse("فشل في بدء المراقبة: " + e.getMessage()));
                }
            }
        });
    }
    
    /**
     * إيقاف مراقبة الأداء
     */
    @JavascriptInterface
    public void stopMonitoring(final String callback) {
        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    if (!isMonitoring) {
                        executeCallback(callback, createErrorResponse("المراقبة غير نشطة"));
                        return;
                    }
                    
                    isMonitoring = false;
                    if (monitoringTimer != null) {
                        monitoringTimer.cancel();
                        monitoringTimer = null;
                    }
                    
                    executeCallback(callback, createSuccessResponse("تم إيقاف مراقبة الأداء"));
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error stopping performance monitoring", e);
                    executeCallback(callback, createErrorResponse("فشل في إيقاف المراقبة: " + e.getMessage()));
                }
            }
        });
    }
    
    /**
     * الحصول على معلومات الذاكرة الحالية
     */
    @JavascriptInterface
    public void getMemoryInfo(final String callback) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    JSONObject memoryInfo = new JSONObject();
                    
                    // معلومات الذاكرة العامة
                    ActivityManager.MemoryInfo systemMemInfo = new ActivityManager.MemoryInfo();
                    activityManager.getMemoryInfo(systemMemInfo);
                    
                    long totalMemory = systemMemInfo.totalMem;
                    long availableMemory = systemMemInfo.availMem;
                    long usedMemory = totalMemory - availableMemory;
                    int memoryPercentage = (int) ((usedMemory * 100) / totalMemory);
                    
                    memoryInfo.put("totalMemory", totalMemory);
                    memoryInfo.put("availableMemory", availableMemory);
                    memoryInfo.put("usedMemory", usedMemory);
                    memoryInfo.put("memoryPercentage", memoryPercentage);
                    memoryInfo.put("isLowMemory", systemMemInfo.lowMemory);
                    memoryInfo.put("threshold", systemMemInfo.threshold);
                    
                    // معلومات Heap للتطبيق
                    Debug.MemoryInfo appMemInfo = new Debug.MemoryInfo();
                    Debug.getMemoryInfo(appMemInfo);
                    
                    JSONObject heapInfo = new JSONObject();
                    heapInfo.put("dalvikPrivateDirty", appMemInfo.dalvikPrivateDirty);
                    heapInfo.put("dalvikPss", appMemInfo.dalvikPss);
                    heapInfo.put("nativePrivateDirty", appMemInfo.nativePrivateDirty);
                    heapInfo.put("nativePss", appMemInfo.nativePss);
                    heapInfo.put("otherPrivateDirty", appMemInfo.otherPrivateDirty);
                    heapInfo.put("otherPss", appMemInfo.otherPss);
                    heapInfo.put("totalPrivateDirty", appMemInfo.getTotalPrivateDirty());
                    heapInfo.put("totalPss", appMemInfo.getTotalPss());
                    
                    memoryInfo.put("heapInfo", heapInfo);
                    
                    // معلومات Runtime
                    Runtime runtime = Runtime.getRuntime();
                    JSONObject runtimeInfo = new JSONObject();
                    runtimeInfo.put("maxMemory", runtime.maxMemory());
                    runtimeInfo.put("totalMemory", runtime.totalMemory());
                    runtimeInfo.put("freeMemory", runtime.freeMemory());
                    runtimeInfo.put("usedMemory", runtime.totalMemory() - runtime.freeMemory());
                    
                    memoryInfo.put("runtimeInfo", runtimeInfo);
                    
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createSuccessResponse("تم تحميل معلومات الذاكرة", memoryInfo));
                        }
                    });
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error getting memory info", e);
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createErrorResponse("فشل في تحميل معلومات الذاكرة: " + e.getMessage()));
                        }
                    });
                }
            }
        }).start();
    }
    
    /**
     * الحصول على معلومات المعالج
     */
    @JavascriptInterface
    public void getCPUInfo(final String callback) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    JSONObject cpuInfo = new JSONObject();
                    
                    // معلومات المعالج الأساسية
                    int coreCount = Runtime.getRuntime().availableProcessors();
                    cpuInfo.put("coreCount", coreCount);
                    
                    // قراءة معلومات CPU من /proc/cpuinfo
                    JSONArray coresInfo = new JSONArray();
                    try {
                        BufferedReader reader = new BufferedReader(new FileReader("/proc/cpuinfo"));
                        String line;
                        JSONObject coreInfo = new JSONObject();
                        
                        while ((line = reader.readLine()) != null) {
                            if (line.startsWith("processor")) {
                                if (coreInfo.length() > 0) {
                                    coresInfo.put(coreInfo);
                                    coreInfo = new JSONObject();
                                }
                                coreInfo.put("processor", line.split(":")[1].trim());
                            } else if (line.startsWith("cpu MHz")) {
                                coreInfo.put("frequency", line.split(":")[1].trim() + " MHz");
                            } else if (line.startsWith("model name")) {
                                coreInfo.put("modelName", line.split(":")[1].trim());
                            }
                        }
                        if (coreInfo.length() > 0) {
                            coresInfo.put(coreInfo);
                        }
                        reader.close();
                    } catch (IOException e) {
                        Log.w(TAG, "Could not read CPU info from /proc/cpuinfo");
                    }
                    
                    cpuInfo.put("coresDetails", coresInfo);
                    
                    // استخدام المعالج الحالي
                    double cpuUsage = getCurrentCPUUsage();
                    cpuInfo.put("currentUsage", cpuUsage);
                    cpuInfo.put("usagePercentage", Math.round(cpuUsage));
                    
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createSuccessResponse("تم تحميل معلومات المعالج", cpuInfo));
                        }
                    });
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error getting CPU info", e);
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createErrorResponse("فشل في تحميل معلومات المعالج: " + e.getMessage()));
                        }
                    });
                }
            }
        }).start();
    }
    
    /**
     * الحصول على معلومات البطارية
     */
    @JavascriptInterface
    public void getBatteryInfo(final String callback) {
        activity.runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    IntentFilter ifilter = new IntentFilter(Intent.ACTION_BATTERY_CHANGED);
                    Intent batteryStatus = activity.registerReceiver(null, ifilter);
                    
                    if (batteryStatus != null) {
                        JSONObject batteryInfo = new JSONObject();
                        
                        // مستوى البطارية
                        int level = batteryStatus.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
                        int scale = batteryStatus.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
                        int batteryPercentage = (int) ((level / (float) scale) * 100);
                        
                        batteryInfo.put("level", level);
                        batteryInfo.put("scale", scale);
                        batteryInfo.put("percentage", batteryPercentage);
                        
                        // حالة الشحن
                        int status = batteryStatus.getIntExtra(BatteryManager.EXTRA_STATUS, -1);
                        boolean isCharging = status == BatteryManager.BATTERY_STATUS_CHARGING ||
                                           status == BatteryManager.BATTERY_STATUS_FULL;
                        
                        batteryInfo.put("isCharging", isCharging);
                        batteryInfo.put("status", getBatteryStatusString(status));
                        
                        // نوع الشاحن
                        int chargePlug = batteryStatus.getIntExtra(BatteryManager.EXTRA_PLUGGED, -1);
                        batteryInfo.put("chargerType", getChargerTypeString(chargePlug));
                        
                        // درجة الحرارة
                        int temperature = batteryStatus.getIntExtra(BatteryManager.EXTRA_TEMPERATURE, -1);
                        if (temperature > 0) {
                            float tempCelsius = temperature / 10.0f;
                            batteryInfo.put("temperature", tempCelsius);
                            batteryInfo.put("temperatureF", (tempCelsius * 9/5) + 32);
                        }
                        
                        // الجهد
                        int voltage = batteryStatus.getIntExtra(BatteryManager.EXTRA_VOLTAGE, -1);
                        if (voltage > 0) {
                            batteryInfo.put("voltage", voltage / 1000.0f); // تحويل إلى فولت
                        }
                        
                        // التكنولوجيا
                        String technology = batteryStatus.getStringExtra(BatteryManager.EXTRA_TECHNOLOGY);
                        batteryInfo.put("technology", technology);
                        
                        // الصحة
                        int health = batteryStatus.getIntExtra(BatteryManager.EXTRA_HEALTH, -1);
                        batteryInfo.put("health", getBatteryHealthString(health));
                        
                        executeCallback(callback, createSuccessResponse("تم تحميل معلومات البطارية", batteryInfo));
                    } else {
                        executeCallback(callback, createErrorResponse("فشل في الحصول على معلومات البطارية"));
                    }
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error getting battery info", e);
                    executeCallback(callback, createErrorResponse("فشل في تحميل معلومات البطارية: " + e.getMessage()));
                }
            }
        });
    }
    
    /**
     * الحصول على إحصائيات الشبكة
     */
    @JavascriptInterface
    public void getNetworkStats(final String callback) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    JSONObject networkStats = new JSONObject();
                    
                    // إحصائيات عامة للجهاز
                    long totalRxBytes = TrafficStats.getTotalRxBytes();
                    long totalTxBytes = TrafficStats.getTotalTxBytes();
                    
                    networkStats.put("totalRxBytes", totalRxBytes);
                    networkStats.put("totalTxBytes", totalTxBytes);
                    networkStats.put("totalBytes", totalRxBytes + totalTxBytes);
                    
                    // إحصائيات منذ بدء المراقبة
                    long sessionRxBytes = totalRxBytes - initialRxBytes;
                    long sessionTxBytes = totalTxBytes - initialTxBytes;
                    
                    networkStats.put("sessionRxBytes", sessionRxBytes);
                    networkStats.put("sessionTxBytes", sessionTxBytes);
                    networkStats.put("sessionTotalBytes", sessionRxBytes + sessionTxBytes);
                    
                    // إحصائيات التطبيق الحالي
                    int uid = android.os.Process.myUid();
                    long appRxBytes = TrafficStats.getUidRxBytes(uid);
                    long appTxBytes = TrafficStats.getUidTxBytes(uid);
                    
                    if (appRxBytes != TrafficStats.UNSUPPORTED) {
                        networkStats.put("appRxBytes", appRxBytes);
                        networkStats.put("appTxBytes", appTxBytes);
                        networkStats.put("appTotalBytes", appRxBytes + appTxBytes);
                    }
                    
                    // حساب السرعة (إذا كانت المراقبة نشطة)
                    if (isMonitoring && performanceHistory.size() > 1) {
                        PerformanceSnapshot lastSnapshot = performanceHistory.get(performanceHistory.size() - 1);
                        PerformanceSnapshot prevSnapshot = performanceHistory.get(performanceHistory.size() - 2);
                        
                        long timeDiff = lastSnapshot.timestamp - prevSnapshot.timestamp;
                        if (timeDiff > 0) {
                            long rxDiff = lastSnapshot.networkRxBytes - prevSnapshot.networkRxBytes;
                            long txDiff = lastSnapshot.networkTxBytes - prevSnapshot.networkTxBytes;
                            
                            double rxSpeed = (rxDiff * 1000.0) / timeDiff; // bytes per second
                            double txSpeed = (txDiff * 1000.0) / timeDiff; // bytes per second
                            
                            networkStats.put("downloadSpeed", rxSpeed);
                            networkStats.put("uploadSpeed", txSpeed);
                            networkStats.put("downloadSpeedKbps", rxSpeed / 1024);
                            networkStats.put("uploadSpeedKbps", txSpeed / 1024);
                        }
                    }
                    
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createSuccessResponse("تم تحميل إحصائيات الشبكة", networkStats));
                        }
                    });
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error getting network stats", e);
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createErrorResponse("فشل في تحميل إحصائيات الشبكة: " + e.getMessage()));
                        }
                    });
                }
            }
        }).start();
    }
    
