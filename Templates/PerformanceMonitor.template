        switch (status) {
            case BatteryManager.BATTERY_STATUS_CHARGING: return "يشحن";
            case BatteryManager.BATTERY_STATUS_DISCHARGING: return "يفرغ";
            case BatteryManager.BATTERY_STATUS_FULL: return "ممتلئ";
