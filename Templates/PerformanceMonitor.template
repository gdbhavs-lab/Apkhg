    /**
     * تحسين الأداء التلقائي
     */
    @JavascriptInterface
    public void optimizePerformance(final String callback) {
        new Thread(new Runnable() {
            @Override
            public void run() {
                try {
                    JSONObject optimizationResult = new JSONObject();
                    JSONArray actions = new JSONArray();
                    
                    // تنظيف الذاكرة
                    long memoryBefore = Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory();
                    System.gc();
                    Thread.sleep(100); // انتظار قصير لإتمام GC
                    long memoryAfter = Runtime.getRuntime().totalMemory() - Runtime.getRuntime().freeMemory();
                    long memoryFreed = memoryBefore - memoryAfter;
                    
                    if (memoryFreed > 0) {
                        actions.put("تم تحرير " + (memoryFreed / 1024) + " KB من الذاكرة");
                    }
                    
                    // تنظيف cache الشبكة
                    if (webView != null) {
                        activity.runOnUiThread(new Runnable() {
                            @Override
                            public void run() {
                                webView.clearCache(true);
                            }
                        });
                        actions.put("تم تنظيف cache المتصفح");
                    }
                    
                    // اقتراحات أخرى
                    if (currentSnapshot != null) {
                        if (currentSnapshot.memoryPercentage > 80) {
                            actions.put("تحذير: استهلاك الذاكرة مرتفع - أغلق التطبيقات غير المستخدمة");
                        }
                        
                        if (currentSnapshot.cpuUsage > 85) {
                            actions.put("تحذير: استهلاك المعالج مرتفع - قلل من العمليات المتزامنة");
                        }
                        
                        if (currentSnapshot.batteryPercentage < 20) {
                            actions.put("تحذير: البطارية منخفضة - فعل وضع توفير الطاقة");
                        }
                    }
                    
                    optimizationResult.put("actions", actions);
                    optimizationResult.put("memoryFreed", memoryFreed);
                    optimizationResult.put("timestamp", System.currentTimeMillis());
                    
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createSuccessResponse("تم تحسين الأداء", optimizationResult));
                        }
                    });
                    
                } catch (Exception e) {
                    Log.e(TAG, "Error optimizing performance", e);
                    activity.runOnUiThread(new Runnable() {
                        @Override
                        public void run() {
                            executeCallback(callback, createErrorResponse("فشل في تحسين الأداء: " + e.getMessage()));
                        }
                    });
                }
            }
        }).start();
    }
    
    /**
     * تعيين إعدادات المراقبة
     */
    @JavascriptInterface
    public void setMonitoringSettings(int interval, int memoryThreshold, int cpuThreshold, int batteryThreshold, int tempThreshold, final String callback) {
        try {
            this.monitoringInterval = Math.max(500, interval); // حد أدنى 500ms
            this.memoryWarningThreshold = Math.max(0, Math.min(100, memoryThreshold));
            this.cpuWarningThreshold = Math.max(0, Math.min(100, cpuThreshold));
            this.batteryWarningThreshold = Math.max(0, Math.min(100, batteryThreshold));
            this.temperatureWarningThreshold = Math.max(0, tempThreshold);
            
            JSONObject settings = new JSONObject();
            settings.put("interval", this.monitoringInterval);
            settings.put("memoryThreshold", this.memoryWarningThreshold);
            settings.put("cpuThreshold", this.cpuWarningThreshold);
            settings.put("batteryThreshold", this.batteryWarningThreshold);
            settings.put("temperatureThreshold", this.temperatureWarningThreshold);
            
            executeCallback(callback, createSuccessResponse("تم تحديث إعدادات المراقبة", settings));
            
        } catch (Exception e) {
            Log.e(TAG, "Error setting monitoring settings", e);
            executeCallback(callback, createErrorResponse("فشل في تحديث الإعدادات: " + e.getMessage()));
        }
    }
    
