 * === Audio Recording ===
 * AppBridge.startRecording("audio.mp3");
 * AppBridge.stopRecording();
 * AppBridge.playAudio("audio.mp3");
 * AppBridge.uploadAudio("audio.mp3", "https://server.com/upload");
