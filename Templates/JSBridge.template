    @JavascriptInterface
    public boolean isNetworkAvailable() {
        try {
            ConnectivityManager cm = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
            NetworkInfo activeNetwork = cm.getActiveNetworkInfo();
            return activeNetwork != null && activeNetwork.isConnected();
        } catch (Exception e) {
            return false;
        }
    }
    
    @JavascriptInterface
    public String getNetworkType() {
        try {
            ConnectivityManager cm = (ConnectivityManager) context.getSystemService(Context.CONNECTIVITY_SERVICE);
            NetworkInfo info = cm.getActiveNetworkInfo();
            if (info != null && info.isConnected()) {
                if (info.getType() == ConnectivityManager.TYPE_WIFI) return "wifi";
                if (info.getType() == ConnectivityManager.TYPE_MOBILE) return "mobile";
            }
            return "none";
        } catch (Exception e) {
            return "unknown";
        }
    }
    
    @JavascriptInterface
    public int getBatteryLevel() {
        try {
            android.content.IntentFilter filter = new android.content.IntentFilter(Intent.ACTION_BATTERY_CHANGED);
            Intent batteryStatus = context.registerReceiver(null, filter);
            int level = batteryStatus.getIntExtra(android.os.BatteryManager.EXTRA_LEVEL, -1);
            int scale = batteryStatus.getIntExtra(android.os.BatteryManager.EXTRA_SCALE, -1);
            return (int) ((level / (float) scale) * 100);
        } catch (Exception e) {
            return -1;
        }
    }
    
    @JavascriptInterface
    public String getStorageInfo() {
        try {
            File path = Environment.getExternalStorageDirectory();
            android.os.StatFs stat = new android.os.StatFs(path.getPath());
            long total = stat.getTotalBytes();
            long free = stat.getAvailableBytes();
            long used = total - free;
            return String.format("{\"total\":%d,\"used\":%d,\"free\":%d}", total, used, free);
        } catch (Exception e) {
            return "{\"error\":\"" + e.getMessage() + "\"}";
        }
    }

    // ==================== SHARE & OPEN ====================
    
    @JavascriptInterface
    public void shareText(String title, String text) {
        try {
            Intent intent = new Intent(Intent.ACTION_SEND);
            intent.setType("text/plain");
            intent.putExtra(Intent.EXTRA_SUBJECT, title);
            intent.putExtra(Intent.EXTRA_TEXT, text);
            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
            context.startActivity(Intent.createChooser(intent, "Share via"));
        } catch (Exception e) {}
    }
    
    @JavascriptInterface
    public void shareFile(String filePath) {
        try {
            File file = new File(filePath);
            if (!file.exists()) {
                file = new File(getAppFolder(), filePath);
            }
            if (file.exists()) {
                Uri uri;
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
                    // Android 7.0+ يحتاج FileProvider
                    uri = FileProvider.getUriForFile(context, 
                        context.getPackageName() + ".fileprovider", file);
                } else {
                    uri = Uri.fromFile(file);
                }
                Intent intent = new Intent(Intent.ACTION_SEND);
                intent.setType(getMimeType(file.getName()));
                intent.putExtra(Intent.EXTRA_STREAM, uri);
                intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
                context.startActivity(Intent.createChooser(intent, "Share file"));
            } else {
                showToast("File not found");
            }
        } catch (Exception e) {
            showToast("Share failed: " + e.getMessage());
        }
    }
    
    private String getMimeType(String filename) {
        String ext = filename.substring(filename.lastIndexOf(".") + 1).toLowerCase();
        switch (ext) {
            case "jpg": case "jpeg": return "image/jpeg";
            case "png": return "image/png";
            case "gif": return "image/gif";
            case "pdf": return "application/pdf";
            case "txt": return "text/plain";
            case "html": return "text/html";
            case "mp3": return "audio/mpeg";
            case "mp4": return "video/mp4";
            case "zip": return "application/zip";
            default: return "*/*";
        }
    }
    
