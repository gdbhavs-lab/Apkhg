    @JavascriptInterface
    public void takePhotoWithSize(String callback, int width, int height, int quality) {
        try {
            cameraCallback = callback;
            targetWidth = width;
            targetHeight = height;
            imageQuality = quality;
            
            Intent intent = new Intent(MediaStore.ACTION_IMAGE_CAPTURE);
            
            // إنشاء ملف للصورة
            File photoFile = new File(getAppFolder(), "camera_" + System.currentTimeMillis() + ".jpg");
            photoFile.getParentFile().mkdirs();
            
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
                cameraImageUri = FileProvider.getUriForFile(context, 
                    context.getPackageName() + ".fileprovider", photoFile);
            } else {
                cameraImageUri = Uri.fromFile(photoFile);
            }
            
            intent.putExtra(MediaStore.EXTRA_OUTPUT, cameraImageUri);
            intent.addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
            ((Activity) context).startActivityForResult(intent, REQUEST_CAMERA);
        } catch (Exception e) {
            showToast("Camera error: " + e.getMessage());
        }
    }
    
    @JavascriptInterface
    public void pickFromGallery(String callback) {
        pickFromGalleryWithSize(callback, 0, 0, 85);
    }
    
    @JavascriptInterface
    public void pickFromGalleryWithSize(String callback, int width, int height, int quality) {
        try {
            cameraCallback = callback;
            targetWidth = width;
            targetHeight = height;
            imageQuality = quality;
            
            Intent intent = new Intent(Intent.ACTION_PICK);
            intent.setType("image/*");
            ((Activity) context).startActivityForResult(intent, REQUEST_GALLERY);
        } catch (Exception e) {
            showToast("Gallery error: " + e.getMessage());
        }
    }
    
    @JavascriptInterface
    public void pickImage(String callback) {
        pickImageWithSize(callback, 0, 0, 85);
    }
    
    @JavascriptInterface
    public void pickImageWithSize(String callback, int width, int height, int quality) {
        try {
            cameraCallback = callback;
            targetWidth = width;
            targetHeight = height;
            imageQuality = quality;
            
            // إنشاء ملف للكاميرا
            File photoFile = new File(getAppFolder(), "camera_" + System.currentTimeMillis() + ".jpg");
            photoFile.getParentFile().mkdirs();
            
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
                cameraImageUri = FileProvider.getUriForFile(context, 
                    context.getPackageName() + ".fileprovider", photoFile);
            } else {
                cameraImageUri = Uri.fromFile(photoFile);
            }
            
            // Intent للاختيار بين الكاميرا والمعرض
            Intent cameraIntent = new Intent(MediaStore.ACTION_IMAGE_CAPTURE);
            cameraIntent.putExtra(MediaStore.EXTRA_OUTPUT, cameraImageUri);
            cameraIntent.addFlags(Intent.FLAG_GRANT_WRITE_URI_PERMISSION);
            
            Intent galleryIntent = new Intent(Intent.ACTION_PICK);
            galleryIntent.setType("image/*");
            
            Intent chooser = Intent.createChooser(galleryIntent, "Select Image");
            chooser.putExtra(Intent.EXTRA_INITIAL_INTENTS, new Intent[]{cameraIntent});
            
            ((Activity) context).startActivityForResult(chooser, REQUEST_PICK_IMAGE);
        } catch (Exception e) {
            showToast("Pick image error: " + e.getMessage());
        }
    }
    
    @JavascriptInterface
    public String getLastImage() {
        return lastImageBase64 != null ? lastImageBase64 : "";
    }
    
    @JavascriptInterface
    public String resizeImage(String base64, int maxWidth, int maxHeight) {
        try {
            byte[] imageBytes = Base64.decode(base64, Base64.DEFAULT);
            Bitmap bitmap = BitmapFactory.decodeByteArray(imageBytes, 0, imageBytes.length);
            Bitmap resized = resizeBitmap(bitmap, maxWidth, maxHeight);
            return bitmapToBase64(resized, 85);
        } catch (Exception e) {
            return "";
        }
    }
    
    @JavascriptInterface
    public String rotateImage(String base64, int degrees) {
        try {
            byte[] imageBytes = Base64.decode(base64, Base64.DEFAULT);
            Bitmap bitmap = BitmapFactory.decodeByteArray(imageBytes, 0, imageBytes.length);
            Matrix matrix = new Matrix();
            matrix.postRotate(degrees);
            Bitmap rotated = Bitmap.createBitmap(bitmap, 0, 0, bitmap.getWidth(), bitmap.getHeight(), matrix, true);
            return bitmapToBase64(rotated, 85);
        } catch (Exception e) {
            return "";
        }
    }
    
    // معالجة نتيجة الكاميرا/المعرض - يُستدعى من MainActivity
    public static void handleActivityResult(Context context, WebView webView, int requestCode, int resultCode, Intent data) {
        if (resultCode != Activity.RESULT_OK) {
            callJsCallback(webView, cameraCallback, "", "cancelled");
            return;
        }
        
        try {
            Bitmap bitmap = null;
            
            if (requestCode == REQUEST_CAMERA) {
                // صورة من الكاميرا
                if (cameraImageUri != null) {
                    InputStream is = context.getContentResolver().openInputStream(cameraImageUri);
                    bitmap = BitmapFactory.decodeStream(is);
                    is.close();
                }
            } else if (requestCode == REQUEST_GALLERY || requestCode == REQUEST_PICK_IMAGE) {
                // صورة من المعرض
                if (data != null && data.getData() != null) {
                    InputStream is = context.getContentResolver().openInputStream(data.getData());
                    bitmap = BitmapFactory.decodeStream(is);
                    is.close();
                } else if (cameraImageUri != null) {
                    // ربما اختار الكاميرا من chooser
                    InputStream is = context.getContentResolver().openInputStream(cameraImageUri);
                    bitmap = BitmapFactory.decodeStream(is);
                    is.close();
                }
            }
            
            if (bitmap != null) {
                // تصغير إذا طُلب
                if (targetWidth > 0 && targetHeight > 0) {
                    bitmap = resizeBitmap(bitmap, targetWidth, targetHeight);
                }
                
                lastImageBase64 = bitmapToBase64(bitmap, imageQuality);
                callJsCallback(webView, cameraCallback, lastImageBase64, "success");
            } else {
                callJsCallback(webView, cameraCallback, "", "error");
            }
        } catch (Exception e) {
            callJsCallback(webView, cameraCallback, "", "error: " + e.getMessage());
        }
    }
    
    private static Bitmap resizeBitmap(Bitmap bitmap, int maxWidth, int maxHeight) {
        int width = bitmap.getWidth();
        int height = bitmap.getHeight();
        
        float ratio = Math.min((float) maxWidth / width, (float) maxHeight / height);
        
        if (ratio >= 1) return bitmap;
        
        int newWidth = Math.round(width * ratio);
        int newHeight = Math.round(height * ratio);
        
        return Bitmap.createScaledBitmap(bitmap, newWidth, newHeight, true);
    }
    
    private static String bitmapToBase64(Bitmap bitmap, int quality) {
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        bitmap.compress(Bitmap.CompressFormat.JPEG, quality, baos);
        byte[] bytes = baos.toByteArray();
        return Base64.encodeToString(bytes, Base64.NO_WRAP);
    }
    
    private static void callJsCallback(final WebView webView, final String callback, final String data, final String status) {
        if (webView == null || callback == null || callback.isEmpty()) return;
        
        ((Activity) webView.getContext()).runOnUiThread(new Runnable() {
            @Override
            public void run() {
                String js = String.format("javascript:%s('%s', '%s')", callback, status, data);
                webView.evaluateJavascript(js, null);
            }
        });
    }
