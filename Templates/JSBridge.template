    // ==================== FILE OPERATIONS ====================
    
    @JavascriptInterface
    public boolean saveFile(String filename, String content) {
        try {
            File file = new File(getAppFolder(), filename);
            file.getParentFile().mkdirs();
            FileOutputStream fos = new FileOutputStream(file);
            fos.write(content.getBytes("UTF-8"));
            fos.close();
            showToast("File saved: " + filename);
            return true;
        } catch (Exception e) {
            showToast("Save failed: " + e.getMessage());
            return false;
        }
    }
    
    @JavascriptInterface
    public boolean saveBase64File(String filename, String base64Data) {
        try {
            // Remove data URL prefix if present
            String data = base64Data;
            if (data.contains(",")) {
                data = data.substring(data.indexOf(",") + 1);
            }
            byte[] bytes = Base64.decode(data, Base64.DEFAULT);
            File file = new File(getAppFolder(), filename);
            file.getParentFile().mkdirs();
            FileOutputStream fos = new FileOutputStream(file);
            fos.write(bytes);
            fos.close();
            showToast("File saved: " + filename);
            return true;
        } catch (Exception e) {
            showToast("Save failed: " + e.getMessage());
            return false;
        }
    }
    
    @JavascriptInterface
    public String readFile(String filename) {
        try {
            File file = new File(getAppFolder(), filename);
            if (!file.exists()) return "";
            FileInputStream fis = new FileInputStream(file);
            BufferedReader reader = new BufferedReader(new InputStreamReader(fis, "UTF-8"));
            StringBuilder sb = new StringBuilder();
            String line;
            while ((line = reader.readLine()) != null) {
                sb.append(line).append("\n");
            }
            reader.close();
            return sb.toString().trim();
        } catch (Exception e) {
            return "";
        }
    }
    
    @JavascriptInterface
    public String readFileBase64(String filename) {
        try {
            File file = new File(getAppFolder(), filename);
            if (!file.exists()) return "";
            FileInputStream fis = new FileInputStream(file);
            byte[] bytes = new byte[(int) file.length()];
            fis.read(bytes);
            fis.close();
            return Base64.encodeToString(bytes, Base64.NO_WRAP);
        } catch (Exception e) {
            return "";
        }
    }
    
