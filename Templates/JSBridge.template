    // ==================== AUDIO RECORDING ====================
    
    @JavascriptInterface
    public boolean startRecording(String filename) {
        try {
            if (isRecording) {
                stopRecording();
            }
            
            File audioFile = new File(getAppFolder(), filename);
            audioFile.getParentFile().mkdirs();
            currentRecordingPath = audioFile.getAbsolutePath();
            
            mediaRecorder = new MediaRecorder();
            mediaRecorder.setAudioSource(MediaRecorder.AudioSource.MIC);
            
            // تحديد الصيغة بناءً على امتداد الملف
            if (filename.toLowerCase().endsWith(".mp3") || filename.toLowerCase().endsWith(".aac")) {
                mediaRecorder.setOutputFormat(MediaRecorder.OutputFormat.MPEG_4);
                mediaRecorder.setAudioEncoder(MediaRecorder.AudioEncoder.AAC);
            } else {
                // WAV/3GP
                mediaRecorder.setOutputFormat(MediaRecorder.OutputFormat.THREE_GPP);
                mediaRecorder.setAudioEncoder(MediaRecorder.AudioEncoder.AMR_NB);
            }
            
            mediaRecorder.setAudioEncodingBitRate(128000);
            mediaRecorder.setAudioSamplingRate(44100);
            mediaRecorder.setOutputFile(currentRecordingPath);
            
            mediaRecorder.prepare();
            mediaRecorder.start();
            
            recordingStartTime = System.currentTimeMillis();
            isRecording = true;
            showToast("Recording started");
            return true;
        } catch (Exception e) {
            showToast("Recording failed: " + e.getMessage());
            return false;
        }
    }
    
    @JavascriptInterface
    public String stopRecording() {
        try {
            if (mediaRecorder != null && isRecording) {
                mediaRecorder.stop();
                mediaRecorder.release();
                mediaRecorder = null;
                isRecording = false;
                showToast("Recording saved");
                return currentRecordingPath;
            }
        } catch (Exception e) {
            showToast("Stop failed: " + e.getMessage());
        }
        return "";
    }
    
