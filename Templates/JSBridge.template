    @JavascriptInterface
    public String listFiles(String folder) {
        try {
            File dir = folder.isEmpty() ? getAppFolder() : new File(getAppFolder(), folder);
            if (!dir.exists() || !dir.isDirectory()) return "[]";
            File[] files = dir.listFiles();
            if (files == null) return "[]";
            StringBuilder sb = new StringBuilder("[");
            for (int i = 0; i < files.length; i++) {
                File f = files[i];
                if (i > 0) sb.append(",");
                sb.append(String.format("{\"name\":\"%s\",\"isDir\":%b,\"size\":%d}", 
                    f.getName(), f.isDirectory(), f.length()));
            }
            sb.append("]");
            return sb.toString();
        } catch (Exception e) {
            return "[]";
        }
    }
    
